% ============================================================
% COMPOUND STRUCTURE
% \rkCompound[conjunction]{word1}{word2}
% Inside \rkSubject/\rkVerb/\rkDObj etc., intercepted by \rk@deferred@Compound
% and rendered as a proper forked compound via \rk@docompound.
% Outside a diagram context the inline fallback applies.
% ============================================================

% \rk@docompound{dir}{conj}{modsa}{worda}{modsb}{wordb}
%   dir = r  subject  (convergence RIGHT, dashed bar on LEFT)
%   dir = l  verb/obj (convergence LEFT,  dashed bar on RIGHT)
%   modsa/modsb = optional modifier lists (e.g. \rkAdj{the}) for each word
\newcommand{\rk@docompound}[6]{%
  % Save outer base_y as compound centre (allows compound objects of preps)
  \setlength{\rk@cmp@basey}{\rk@base@y}%
  % rk@ta = csep  (vertical half-gap between platforms)
  \setlength{\rk@ta}{\rk@ht}%
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  % Measure conjunction width; expand csep so rotated label fits inside the bar
  \begingroup
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@conjN)at(0,0){\textit{#2}};%
  \endgroup
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@conjN}{east}}%
  \pgfextractx{\rk@tb}{\pgfpointanchor{rk@conjN}{west}}%
  \addtolength{\rk@tc}{-\rk@tb}%    rk@tc = conjunction text width
  \divide\rk@tc by 2\relax%
  \addtolength{\rk@tc}{4pt}%        rk@tc = half-width + small padding
  \ifdim\rk@tc>\rk@ta\setlength{\rk@ta}{\rk@tc}\fi%  csep = max(rk@ht, conj_half+pad)
  % Apply cmpSep minimum if set (overrides auto csep)
  \ifdim\rk@cmpsep>\rk@ta\setlength{\rk@ta}{\rk@cmpsep}\fi%
  % Measure word widths (inline-mod context suppresses any embedded modifier draws)
  \begingroup
    \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@cmpA)at(0,0){#4};%
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@cmpB)at(0,0){#6};%
  \endgroup
  \pgfextractx{\rk@effmod}{\pgfpointanchor{rk@cmpA}{east}}%
  \pgfextractx{\rk@tb}    {\pgfpointanchor{rk@cmpA}{west}}%
  \addtolength{\rk@effmod}{-\rk@tb}%           rk@effmod = width_A
  \setlength{\rk@cmp@wa}{\rk@effmod}%          save width_A for centring
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@cmpB}{east}}%
  \pgfextractx{\rk@tb}{\pgfpointanchor{rk@cmpB}{west}}%
  \addtolength{\rk@tc}{-\rk@tb}%               rk@tc = width_B
  \setlength{\rk@cmp@wb}{\rk@tc}%              save width_B for centring
  \ifdim\rk@tc>\rk@effmod\setlength{\rk@effmod}{\rk@tc}\fi
  % rk@effmod = max word width; platform width = max + full spacing margin
  \addtolength{\rk@effmod}{\rk@spacing}%
  %
  \if r#1%  %----- SUBJECT: convergence RIGHT --------------------------
    % plat_l = rk@x,  bar_x = rk@x + effmod + gap,  conv_x = bar_x + csep + halfsep
    % gap = rk@halfsep separates the text platform end from the dashed bar
    % extra halfsep added to conv_x only — keeps word separation (rk@ta) unchanged
    \setlength{\rk@tb}{\rk@x}\addtolength{\rk@tb}{\rk@effmod}%  rk@tb = text end x
    \addtolength{\rk@tb}{\rk@halfsep}%                           rk@tb = bar_x
    \setlength{\rk@tc}{\rk@tb}\addtolength{\rk@tc}{\rk@ta}%
    \addtolength{\rk@tc}{\rk@halfsep}%                           rk@tc = conv_x
    \setlength{\rk@sl@l}{\rk@x}\addtolength{\rk@sl@l}{\rk@halfsep}%  text_x
    \setlength{\rk@cmp@textx}{\rk@sl@l}%
    \setlength{\rk@cmp@csep}{\rk@ta}%
    % Word y = cmp@basey ± csep + wordlift; words centred on their platforms.
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
    \begingroup
      \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
      % centre_x_A = sl@l + cmp@wa/2  (text_x + half word width)
      \setlength{\rk@tc}{\rk@sl@l}%
      \setlength{\rk@tb}{\rk@cmp@wa}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpAN)at(\the\rk@tc, \the\rk@wlevel){#4};%
      \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
      % centre_x_B = sl@l + cmp@wb/2
      \setlength{\rk@tc}{\rk@sl@l}%
      \setlength{\rk@tb}{\rk@cmp@wb}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpBN)at(\the\rk@tc, \the\rk@wlevel){#6};%
    \endgroup
    % Platform baselines (upper y = cmp@basey+ta, lower y = cmp@basey-ta)
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \rk@line{(\the\rk@x, \the\rk@wlevel)--(\the\rk@tb, \the\rk@wlevel)}%
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}%
    \rk@line{(\the\rk@x, \the\rk@wlevel)--(\the\rk@tb, \the\rk@wlevel)}%
    % Dashed vertical bar and conjunction label
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \setlength{\rk@sl@d}{\rk@cmp@basey}\addtolength{\rk@sl@d}{-\the\rk@ta}%
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@tb, \the\rk@wlevel)--(\the\rk@tb, \the\rk@sl@d);%
    \node[rotate=90,anchor=north,inner sep=2pt,font=\rk@font]
      at (\the\rk@tb, \the\rk@cmp@basey) {\textit{#2}};%
    % Convergence slants
    \rk@line{(\the\rk@tb, \the\rk@wlevel)--(\the\rk@tc, \the\rk@cmp@basey)}%
    \rk@line{(\the\rk@tb, \the\rk@sl@d)--(\the\rk@tc, \the\rk@cmp@basey)}%
    \setlength{\rk@cmp@platright}{\rk@tb}%
    \pgfextracty{\rk@tb}{\pgfpointanchor{rk@cmpAN}{north}}%
    \ifdim\rk@tb>\rk@ht\setlength{\rk@ht}{\rk@tb}\fi
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%
    \setlength{\rk@sl@y}{\rk@cmp@basey}\setlength{\rk@x}{\rk@tc}%
  \else%   %----- VERB / OBJ: convergence LEFT --------------------------
    \setlength{\rk@tb}{\rk@x}\addtolength{\rk@tb}{\rk@ta}%
    \addtolength{\rk@tb}{\rk@halfsep}%                           rk@tb = bar_x
    \setlength{\rk@sl@l}{\rk@tb}%
    \setlength{\rk@tc}{\rk@sl@l}\addtolength{\rk@tc}{\rk@effmod}%  rk@tc = plat_r
    \setlength{\rk@effmod}{\rk@sl@l}\addtolength{\rk@effmod}{\rk@halfsep}%  text_x
    \setlength{\rk@cmp@textx}{\rk@effmod}%
    \setlength{\rk@cmp@csep}{\rk@ta}%
    % Word y levels; words centred on their platforms (centre_x = text_x + width/2).
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
    \begingroup
      \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
      % centre_x_A = effmod + cmp@wa/2
      \setlength{\rk@tc}{\rk@effmod}%
      \setlength{\rk@tb}{\rk@cmp@wa}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpAN)at(\the\rk@tc, \the\rk@wlevel){#4};%
      \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
      % centre_x_B = effmod + cmp@wb/2
      \setlength{\rk@tc}{\rk@effmod}%
      \setlength{\rk@tb}{\rk@cmp@wb}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpBN)at(\the\rk@tc, \the\rk@wlevel){#6};%
    \endgroup
    % Platform baselines
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \rk@line{(\the\rk@tb, \the\rk@wlevel)--(\the\rk@tc, \the\rk@wlevel)}%
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}%
    \rk@line{(\the\rk@tb, \the\rk@wlevel)--(\the\rk@tc, \the\rk@wlevel)}%
    % Convergence slants
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \setlength{\rk@sl@d}{\rk@cmp@basey}\addtolength{\rk@sl@d}{-\the\rk@ta}%
    \rk@line{(\the\rk@x, \the\rk@cmp@basey)--(\the\rk@tb, \the\rk@wlevel)}%
    \rk@line{(\the\rk@x, \the\rk@cmp@basey)--(\the\rk@tb, \the\rk@sl@d)}%
    % Dashed vertical bar and conjunction label
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@sl@l, \the\rk@wlevel)--(\the\rk@sl@l, \the\rk@sl@d);%
    \node[rotate=90,anchor=south,inner sep=2pt,font=\rk@font]
      at (\the\rk@sl@l, \the\rk@cmp@basey) {\textit{#2}};%
    \setlength{\rk@cmp@platright}{\rk@tc}%
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%
    \setlength{\rk@sl@y}{\rk@cmp@basey}\setlength{\rk@x}{\rk@tc}%
  \fi
  % Run modifier/slot extensions for each word in its platform context.
  \ifblank{#3}{}{%
    \begingroup
      \setlength{\rk@base@y}{\rk@cmp@basey}\addtolength{\rk@base@y}{\rk@cmp@csep}%
      \setlength{\rk@mc@y}{\rk@base@y}%
      \setlength{\rk@mc@cur}{\rk@cmp@textx}%
      \setlength{\rk@mc@d}{\rk@cmp@textx}%
      \setlength{\rk@x}{\rk@cmp@platright}%
      \setlength{\rk@ht}{2.2ex}%
      \rk@extendblfalse
      \rk@execmods{#3}%
    \endgroup
  }%
  \ifblank{#5}{}{%
    \begingroup
      \setlength{\rk@base@y}{\rk@cmp@basey}\addtolength{\rk@base@y}{-\the\rk@cmp@csep}%
      \setlength{\rk@mc@y}{\rk@base@y}%
      \setlength{\rk@mc@cur}{\rk@cmp@textx}%
      \setlength{\rk@mc@d}{\rk@cmp@textx}%
      \setlength{\rk@x}{\rk@cmp@platright}%
      \setlength{\rk@ht}{2.2ex}%
      \rk@extendblfalse
      \rk@execmods{#5}%
    \endgroup
  }%
}

% Inline fallback (used outside diagram context or as a safety net)
% Signature: [conj][mods_a]{word_a}[mods_b]{word_b}
\NewDocumentCommand{\rkCompound}{O{and} O{} m O{} m}{%
  \begingroup
    \let\rkAdj\rk@inline@mod
    \let\rkAdv\rk@inline@mod
    \let\rkPrep\rk@inline@prep
    #3~\textit{#1}~#5%
  \endgroup
}

