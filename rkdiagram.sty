}

% ============================================================
% COMPOUND STRUCTURE
% \rkCompound[conjunction]{word1}{word2}
% Inside \rkSubject/\rkVerb/\rkDObj etc., intercepted by \rk@deferred@Compound
% and rendered as a proper forked compound via \rk@docompound.
% Outside a diagram context the inline fallback applies.
% ============================================================

% \rk@docompound{dir}{conj}{modsa}{worda}{modsb}{wordb}
%   dir = r  subject  (convergence RIGHT, dashed bar on LEFT)
%   dir = l  verb/obj (convergence LEFT,  dashed bar on RIGHT)
%   modsa/modsb = optional modifier lists (e.g. \rkAdj{the}) for each word
\newcommand{\rk@docompound}[6]{%
  % Save outer base_y as compound centre (allows compound objects of preps)
  \setlength{\rk@cmp@basey}{\rk@base@y}%
  % rk@ta = csep  (vertical half-gap between platforms)
  \setlength{\rk@ta}{\rk@ht}%
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  % Measure conjunction width; expand csep so rotated label fits inside the bar
  \begingroup
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@conjN)at(0,0){\phantom{\textit{#2}}};%
  \endgroup
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@conjN}{east}}%
  \pgfextractx{\rk@tb}{\pgfpointanchor{rk@conjN}{west}}%
  \addtolength{\rk@tc}{-\rk@tb}%    rk@tc = conjunction text width
  \divide\rk@tc by 2\relax%
  \addtolength{\rk@tc}{4pt}%        rk@tc = half-width + small padding
  \ifdim\rk@tc>\rk@ta\setlength{\rk@ta}{\rk@tc}\fi%  csep = max(rk@ht, conj_half+pad)
  % Apply cmpSep minimum if set (overrides auto csep)
  \ifdim\rk@cmpsep>\rk@ta\setlength{\rk@ta}{\rk@cmpsep}\fi%
  % Measure word widths (inline-mod context suppresses any embedded modifier draws)
  \begingroup
    \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@cmpA)at(0,0){\phantom{#4}};%
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@cmpB)at(0,0){\phantom{#6}};%
  \endgroup
  \pgfextractx{\rk@effmod}{\pgfpointanchor{rk@cmpA}{east}}%
  \pgfextractx{\rk@tb}    {\pgfpointanchor{rk@cmpA}{west}}%
  \addtolength{\rk@effmod}{-\rk@tb}%           rk@effmod = width_A
  \setlength{\rk@cmp@wa}{\rk@effmod}%          save width_A for centring
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@cmpB}{east}}%
  \pgfextractx{\rk@tb}{\pgfpointanchor{rk@cmpB}{west}}%
  \addtolength{\rk@tc}{-\rk@tb}%               rk@tc = width_B
  \setlength{\rk@cmp@wb}{\rk@tc}%              save width_B for centring
  \ifdim\rk@tc>\rk@effmod\setlength{\rk@effmod}{\rk@tc}\fi
  % rk@effmod = max word width; platform width = max + full spacing margin
  \addtolength{\rk@effmod}{\rk@spacing}%
  %
  \if r#1%  %----- SUBJECT: convergence RIGHT --------------------------
    % plat_l = rk@x,  bar_x = rk@x + effmod + gap,  conv_x = bar_x + csep + halfsep
    % gap = rk@halfsep separates the text platform end from the dashed bar
    % extra halfsep added to conv_x only — keeps word separation (rk@ta) unchanged
    \setlength{\rk@tb}{\rk@x}\addtolength{\rk@tb}{\rk@effmod}%  rk@tb = text end x
    \addtolength{\rk@tb}{\rk@halfsep}%                           rk@tb = bar_x
    \setlength{\rk@tc}{\rk@tb}\addtolength{\rk@tc}{\rk@ta}%
    \addtolength{\rk@tc}{\rk@halfsep}%                           rk@tc = conv_x
    \setlength{\rk@sl@l}{\rk@x}\addtolength{\rk@sl@l}{\rk@halfsep}%  text_x
    \setlength{\rk@cmp@textx}{\rk@sl@l}%
    \setlength{\rk@cmp@csep}{\rk@ta}%
    % Word y = cmp@basey ± csep + wordlift; words centred on their platforms.
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
    \begingroup
      \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
      % centre_x_A = sl@l + cmp@wa/2  (text_x + half word width)
      \setlength{\rk@tc}{\rk@sl@l}%
      \setlength{\rk@tb}{\rk@cmp@wa}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpAN)at(\the\rk@tc, \the\rk@wlevel){#4};%
      \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
      % centre_x_B = sl@l + cmp@wb/2
      \setlength{\rk@tc}{\rk@sl@l}%
      \setlength{\rk@tb}{\rk@cmp@wb}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpBN)at(\the\rk@tc, \the\rk@wlevel){#6};%
    \endgroup
    % Platform baselines (upper y = cmp@basey+ta, lower y = cmp@basey-ta)
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \rk@line{(\the\rk@x, \the\rk@wlevel)--(\the\rk@tb, \the\rk@wlevel)}%
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}%
    \rk@line{(\the\rk@x, \the\rk@wlevel)--(\the\rk@tb, \the\rk@wlevel)}%
    % Dashed vertical bar and conjunction label
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \setlength{\rk@sl@d}{\rk@cmp@basey}\addtolength{\rk@sl@d}{-\the\rk@ta}%
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@tb, \the\rk@wlevel)--(\the\rk@tb, \the\rk@sl@d);%
    \node[rotate=90,anchor=north,inner sep=2pt,font=\rk@font]
      at (\the\rk@tb, \the\rk@cmp@basey) {\textit{#2}};%
    % Convergence slants
    \rk@line{(\the\rk@tb, \the\rk@wlevel)--(\the\rk@tc, \the\rk@cmp@basey)}%
    \rk@line{(\the\rk@tb, \the\rk@sl@d)--(\the\rk@tc, \the\rk@cmp@basey)}%
    \setlength{\rk@cmp@platright}{\rk@tb}%
    \pgfextracty{\rk@tb}{\pgfpointanchor{rk@cmpAN}{north}}%
    \ifdim\rk@tb>\rk@ht\setlength{\rk@ht}{\rk@tb}\fi
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%
    \setlength{\rk@sl@y}{\rk@cmp@basey}\setlength{\rk@x}{\rk@tc}%
  \else%   %----- VERB / OBJ: convergence LEFT --------------------------
    \setlength{\rk@tb}{\rk@x}\addtolength{\rk@tb}{\rk@ta}%
    \addtolength{\rk@tb}{\rk@halfsep}%                           rk@tb = bar_x
    \setlength{\rk@sl@l}{\rk@tb}%
    \setlength{\rk@tc}{\rk@sl@l}\addtolength{\rk@tc}{\rk@effmod}%  rk@tc = plat_r
    \setlength{\rk@effmod}{\rk@sl@l}\addtolength{\rk@effmod}{\rk@halfsep}%  text_x
    \setlength{\rk@cmp@textx}{\rk@effmod}%
    \setlength{\rk@cmp@csep}{\rk@ta}%
    % Word y levels; words centred on their platforms (centre_x = text_x + width/2).
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
    \begingroup
      \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
      % centre_x_A = effmod + cmp@wa/2
      \setlength{\rk@tc}{\rk@effmod}%
      \setlength{\rk@tb}{\rk@cmp@wa}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpAN)at(\the\rk@tc, \the\rk@wlevel){#4};%
      \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}\addtolength{\rk@wlevel}{\rk@wordlift}%
      % centre_x_B = effmod + cmp@wb/2
      \setlength{\rk@tc}{\rk@effmod}%
      \setlength{\rk@tb}{\rk@cmp@wb}\divide\rk@tb by 2\relax\addtolength{\rk@tc}{\rk@tb}%
      \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpBN)at(\the\rk@tc, \the\rk@wlevel){#6};%
    \endgroup
    % Platform baselines
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \rk@line{(\the\rk@tb, \the\rk@wlevel)--(\the\rk@tc, \the\rk@wlevel)}%
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{-\the\rk@ta}%
    \rk@line{(\the\rk@tb, \the\rk@wlevel)--(\the\rk@tc, \the\rk@wlevel)}%
    % Convergence slants
    \setlength{\rk@wlevel}{\rk@cmp@basey}\addtolength{\rk@wlevel}{\rk@ta}%
    \setlength{\rk@sl@d}{\rk@cmp@basey}\addtolength{\rk@sl@d}{-\the\rk@ta}%
    \rk@line{(\the\rk@x, \the\rk@cmp@basey)--(\the\rk@tb, \the\rk@wlevel)}%
    \rk@line{(\the\rk@x, \the\rk@cmp@basey)--(\the\rk@tb, \the\rk@sl@d)}%
    % Dashed vertical bar and conjunction label
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@sl@l, \the\rk@wlevel)--(\the\rk@sl@l, \the\rk@sl@d);%
    \node[rotate=90,anchor=south,inner sep=2pt,font=\rk@font]
      at (\the\rk@sl@l, \the\rk@cmp@basey) {\textit{#2}};%
    \setlength{\rk@cmp@platright}{\rk@tc}%
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%
    \setlength{\rk@sl@y}{\rk@cmp@basey}\setlength{\rk@x}{\rk@tc}%
  \fi
  % Run modifier/slot extensions for each word in its platform context.
  \ifblank{#3}{}{%
    \begingroup
      \setlength{\rk@base@y}{\rk@cmp@basey}\addtolength{\rk@base@y}{\rk@cmp@csep}%
      \setlength{\rk@mc@y}{\rk@base@y}%
      \setlength{\rk@mc@cur}{\rk@cmp@textx}%
      \setlength{\rk@mc@d}{\rk@cmp@textx}%
      \setlength{\rk@x}{\rk@cmp@platright}%
      \setlength{\rk@ht}{2.2ex}%
      \rk@extendblfalse
      \rk@execmods{#3}%
    \endgroup
  }%
  \ifblank{#5}{}{%
    \begingroup
      \setlength{\rk@base@y}{\rk@cmp@basey}\addtolength{\rk@base@y}{-\the\rk@cmp@csep}%
      \setlength{\rk@mc@y}{\rk@base@y}%
      \setlength{\rk@mc@cur}{\rk@cmp@textx}%
      \setlength{\rk@mc@d}{\rk@cmp@textx}%
      \setlength{\rk@x}{\rk@cmp@platright}%
      \setlength{\rk@ht}{2.2ex}%
      \rk@extendblfalse
      \rk@execmods{#5}%
    \endgroup
  }%
}

% Inline fallback (used outside diagram context or as a safety net)
% Signature: [conj][mods_a]{word_a}[mods_b]{word_b}
\NewDocumentCommand{\rkCompound}{O{and} O{} m O{} m}{%
  \begingroup
    \let\rkAdj\rk@inline@mod
    \let\rkAdv\rk@inline@mod
    \let\rkPrep\rk@inline@prep
    #3~\textit{#1}~#5%
  \endgroup
}

% ============================================================
% APPOSITIVE
% \rkAppos{content}
% ============================================================

\NewDocumentCommand{\rkAppos}{m}{%
  \rk@doappos{#1}%
}

% ============================================================
% SUBORDINATE CLAUSE
% \rkSubClause[rel-word]{body}
% ============================================================

\NewDocumentCommand{\rkSubClause}{O{}m}{%
  \rk@dosubclause{#1}{#2}%
}

% ============================================================
% GERUND PRE-SCAN HOOKS
%
% These lightweight commands are substituted for \rkAdj, \rkAdv, \rkPrep
% during a dry-run pass over the gerund's modifier list.  Each one measures
% the depth its slant would occupy and records the maximum in rk@grd@maxdepth.
% Sub-modifiers add an extra modDepth level to the depth estimate.
% ============================================================

% \rk@grd@scanmod[submods]{word}  — covers \rkAdj and \rkAdv
\NewDocumentCommand{\rk@grd@scanmod}{O{} m}{%
  \node[opacity=0, inner sep=2pt, outer sep=0pt, font=\rk@font]
    (rk@grdscan) at (0,0) {\phantom{#2}};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@grdscan}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@grdscan}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%           rk@tc = node width
  \pgfextracty{\rk@tb}{\pgfpointanchor{rk@grdscan}{north}}%
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@grdscan}{south}}%
  \addtolength{\rk@tb}{-\rk@ta}%           rk@tb = node height
  \pgfmathsetlength{\rk@ta}{max(\the\rk@modDepth,(\the\rk@tc+\the\rk@tb)/1.41422+6pt)}%
  \ifblank{#1}{}{\addtolength{\rk@ta}{\rk@modDepth}}% one extra level for sub-mods
  \ifdim\rk@ta>\rk@grd@maxdepth\global\rk@grd@maxdepth=\rk@ta\fi
}

% \rk@grd@scanprep[mods-on-obj]{prep}{obj}  — covers \rkPrep
\NewDocumentCommand{\rk@grd@scanprep}{O{} m m}{%
  \node[opacity=0, inner sep=2pt, outer sep=0pt, font=\rk@font]
    (rk@grdscan) at (0,0) {\phantom{#2}};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@grdscan}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@grdscan}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%
  \pgfextracty{\rk@tb}{\pgfpointanchor{rk@grdscan}{north}}%
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@grdscan}{south}}%
  \addtolength{\rk@tb}{-\rk@ta}%
  \pgfmathsetlength{\rk@ta}{max(\the\rk@modDepth,(\the\rk@tc+\the\rk@tb)/1.41422+6pt)}%
  \ifdim\rk@ta>\rk@grd@maxdepth\global\rk@grd@maxdepth=\rk@ta\fi
}

% ============================================================
% GERUND PLATFORM
% \rk@dogerund{foot-y}
%
% Draws the stepped T-platform for a gerund:
%   foot  — long horizontal at foot-y (the noun-slot baseline)
%   post  — vertical from foot centre up by the computed post height
%   plat  — short horizontal at post top (the word sits here)
%
% Post height is computed adaptively: a dry-run pre-scan over the gerund's
% own modifier list (stored in rk@deferredgrd@mods) finds the deepest slant;
% the post is made tall enough to keep all modifier slants clear of the foot.
% rk@gerundpost is the minimum post height (user-configurable floor).
%
% Records rk@sl@* on the word platform so \rk@slot@to@mc and subsequent
% modifier runs attach at the correct level.
% ============================================================

\newcommand{\rk@dogerund}[1]{%
  % #1 = foot y (e.g. \the\rk@base@y)
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  % --- Pre-scan modifier list to find the deepest slant ---
  \setlength{\rk@grd@maxdepth}{0pt}%
  \ifblank{\rk@deferredgrd@mods}{}{%
    \begingroup
      \let\rkAdj\rk@grd@scanmod
      \let\rkAdv\rk@grd@scanmod
      \let\rkPrep\rk@grd@scanprep
      \let\rkSubClause\@gobbletwo        % ignore subclauses during scan
      \let\rkAppos\@gobble               % ignore appositives during scan
      \rk@execmods{\rk@deferredgrd@mods}%
    \endgroup
  }%
  % Compute post height: at least rk@gerundpost, at least maxdepth + 2*modgap
  \ifdim\rk@grd@posth@force>0pt
    \setlength{\rk@grd@posth}{\rk@grd@posth@force}%   forced override
  \else
    \setlength{\rk@grd@posth}{\rk@gerundpost}%
    \ifdim\rk@grd@maxdepth>0pt
      \setlength{\rk@ta}{\rk@grd@maxdepth}%
      \addtolength{\rk@ta}{\rk@modgap}\addtolength{\rk@ta}{\rk@modgap}%
      \ifdim\rk@ta>\rk@grd@posth\setlength{\rk@grd@posth}{\rk@ta}\fi
    \fi
  \fi
  % --- Measure gerund word ---
  \node[opacity=0, inner sep=0pt, outer sep=0pt, font=\rk@font]
    (rk@grdmsr) at (0,0) {\phantom{\rk@deferredgrd@word}};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@grdmsr}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@grdmsr}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%             rk@tc = word_width
  \setlength{\rk@grd@wordw}{\rk@tc}%         save word_width for geometry and angle
  % Update rk@ht from gerund word's text height (same as \rk@placeslot does for any word).
  % Without this, rk@ht stays at the 2.2ex initial value, making \rk@divfwd draw a
  % longer slant than equivalent noun subjects produce.
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@grdmsr}{north}}%
  \ifdim\rk@ta>\rk@ht\setlength{\rk@ht}{\rk@ta}\fi
  % --- X layout: shelf centred on post_x (triangle apex at shelf midpoint) ---
  % shelf_left  = rk@x + halfsep
  \setlength{\rk@ta}{\rk@x}\addtolength{\rk@ta}{\rk@halfsep}%           rk@ta = shelf_left
  % upper_post_x / shelf_right = shelf_left + word_width
  \setlength{\rk@tc}{\rk@ta}\addtolength{\rk@tc}{\rk@grd@wordw}%         rk@tc = upper_post_x
  % foot_right = upper_post_x + halfsep + shelfext
  \setlength{\rk@effmod}{\rk@tc}\addtolength{\rk@effmod}{\rk@halfsep}%
  \addtolength{\rk@effmod}{\rk@grd@shelfext}%                              rk@effmod = foot_right
  % extend lower shelf right end by shelfext too
  \addtolength{\rk@tc}{\rk@grd@shelfext}%                                  rk@tc = lower shelf right
  % post_x = midpoint of shelf
  \setlength{\rk@tb}{\rk@ta}\addtolength{\rk@tb}{\rk@tc}\divide\rk@tb by 2\relax  % rk@tb = post_x
  % --- Y coordinates ---
  % shelf_y = foot_y + grd@posth
  \setlength{\rk@grd@maxdepth}{#1}\addtolength{\rk@grd@maxdepth}{\rk@grd@posth}%
  % apex_y = foot_y + (2/3)*halfsep
  \setlength{\rk@wlevel}{#1}%
  \pgfmathsetlength{\rk@grd@fh}{\the\rk@halfsep * 2 / 3}%
  \addtolength{\rk@wlevel}{\rk@grd@fh}%   rk@wlevel = apex_y
  % --- Triangle: full-width foot and scaled legs ---
  \pgfmathsetlength{\rk@grd@fh}{\the\rk@halfsep * 2 / 3 / 1.73205}%  half-base
  \rk@line{(\the\rk@x, #1) -- (\the\rk@effmod, #1)}%                              foot
  \rk@line{(\the\dimexpr\rk@tb-\rk@grd@fh\relax, #1) -- (\the\rk@tb, \the\rk@wlevel)}% left leg
  \rk@line{(\the\dimexpr\rk@tb+\rk@grd@fh\relax, #1) -- (\the\rk@tb, \the\rk@wlevel)}% right leg
  % --- Lower post: triangle apex to shelf_y (centred on shelf) ---
  \rk@line{(\the\rk@tb, \the\rk@wlevel) -- (\the\rk@tb, \the\rk@grd@maxdepth)}%
  % Repurpose rk@wlevel → top_y = shelf_y + halfsep
  \setlength{\rk@wlevel}{\rk@grd@maxdepth}\addtolength{\rk@wlevel}{\rk@halfsep}%
  % --- Step shape (0,0 = top of lower post): lower shelf (-4,0)→(+4,0),
  %     step vertical (-4,0)→(-4,+2), top shelf (-8,+2)→(-4,+2) ---
  % Lower shelf: shelf_left to shelf_right at shelf_y
  \rk@line{(\the\rk@ta, \the\rk@grd@maxdepth) -- (\the\rk@tc, \the\rk@grd@maxdepth)}%
  % Step vertical: at shelf_left, from shelf_y up to top_y
  \rk@line{(\the\rk@ta, \the\rk@grd@maxdepth) -- (\the\rk@ta, \the\rk@wlevel)}%
  % Top shelf: extends LEFT from shelf_left by word_width * 3/8 at top_y (3/4 of former width/2)
  \pgfmathsetlength{\rk@grd@fh}{\the\rk@grd@wordw * 3 / 8}%
  \setlength{\rk@grd@fh}{\dimexpr\rk@ta-\rk@grd@fh\relax}%   rk@grd@fh = top_shelf_left
  \rk@line{(\the\rk@grd@fh, \the\rk@wlevel) -- (\the\rk@ta, \the\rk@wlevel)}%
  % --- Record slot (modifiers attach from shelf level) ---
  % sl@l = post_x so \rk@slot@to@mc starts modifier slants right of the lower post.
  \setlength{\rk@sl@l}{\rk@tb}%    post_x
  \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%  shelf_right
  \setlength{\rk@sl@y}{\rk@grd@maxdepth}%  shelf_y
  % Advance main cursor
  \setlength{\rk@x}{\rk@effmod}%
  % --- Diagonal word: end anchored at (shelf_right, shelf_y), start raised to
  %     2*halfsep above the shelf so its baseline clears the top-shelf corner ---
  % mid_x = (top_shelf_left + shelf_right)/2
  \addtolength{\rk@grd@fh}{\rk@tc}\divide\rk@grd@fh by 2\relax%  rk@grd@fh = mid_x
  % mid_y = shelf_y + halfsep  (half of the 2*halfsep rise)
  \setlength{\rk@ta}{\rk@grd@maxdepth}\addtolength{\rk@ta}{\rk@halfsep}%  rk@ta = mid_y
  % angle: drop = 2*halfsep over run = 1.5 * word_width
  \pgfmathsetmacro{\rk@grd@angle}{atan2(-2 * \strip@pt\rk@halfsep, \strip@pt\rk@grd@wordw * 1.5)}%
  \node[anchor=base, rotate=\rk@grd@angle, inner sep=0pt, outer sep=0pt, font=\rk@font]
    at (\the\rk@grd@fh, \the\rk@ta) {\rk@deferredgrd@word};%
  % --- Run gerund's own modifiers from the shelf ---
  \ifblank{\rk@deferredgrd@mods}{}{%
    \rk@slot@to@mc
    \rk@runmods{\rk@deferredgrd@mods}%
  }%
  % --- Update clause miny for bridge placement ---
  \setlength{\rk@ta}{#1}%
  \ifdim\rk@ta<\rk@clause@miny\global\rk@clause@miny=\rk@ta\fi
}

% ============================================================
% GERUND
% \rkGerund[mods]{word}
% Use as the word argument of \rkSubject, \rkDObj, \rkPredNom, etc.
% The optional [mods] are modifiers of the gerund word itself; they are
% pre-scanned to compute the post height before drawing begins.
% ============================================================

\NewDocumentCommand{\rkGerund}{O{} m}{%
  % Inline fallback (outside diagram context): just typeset the word.
  \textit{#2}%
}

% ============================================================
% INFINITIVE
%
% \rkInfinitive[arg]{verb}
%
% NOUN FORM (deferred — used as word argument of \rkSubject, \rkDObj, etc.):
%   Same stepped pedestal as \rkGerund, but "to" is labeled on the
%   vertical post.  [arg] = modifiers of the verb (pre-scanned for post height).
%
% MODIFIER FORM (default — used inside [mods] of \rkSubject, \rkDObj, etc.):
%   Diagonal labeled "to" (like a prepositional phrase) with the verb on
%   the horizontal at the bottom.  [arg] = tail content for the verb's
%   mini-baseline (use \rkInfObj[mods]{word} for a direct object, \rkAdv
%   and \rkPrep for adverbial modifiers of the infinitive verb).
% ============================================================

% \rk@doinfinitive{foot-y}
% Noun form: pedestal + "to" on post + verb on platform.
\newcommand{\rk@doinfinitive}[1]{%
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  % Pre-scan mods for adaptive post height (identical to gerund's pre-scan)
  \setlength{\rk@grd@maxdepth}{0pt}%
  \ifblank{\rk@deferredinf@mods}{}{%
    \begingroup
      \let\rkAdj\rk@grd@scanmod
      \let\rkAdv\rk@grd@scanmod
      \let\rkPrep\rk@grd@scanprep
      \let\rkSubClause\@gobbletwo
      \let\rkAppos\@gobble
      \rk@execmods{\rk@deferredinf@mods}%
    \endgroup
  }%
  \setlength{\rk@grd@posth}{\rk@gerundpost}%
  \ifdim\rk@grd@maxdepth>0pt
    \setlength{\rk@ta}{\rk@grd@maxdepth}%
    \addtolength{\rk@ta}{\rk@modgap}\addtolength{\rk@ta}{\rk@modgap}%
    \ifdim\rk@ta>\rk@grd@posth\setlength{\rk@grd@posth}{\rk@ta}\fi
  \fi
  % Measure verb word
  \node[opacity=0, inner sep=0pt, outer sep=0pt, font=\rk@font]
    (rk@infmsr) at (0,0) {\phantom{\rk@deferredinf@word}};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@infmsr}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@infmsr}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%    rk@tc = verb_width
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@infmsr}{north}}%
  \ifdim\rk@ta>\rk@ht\setlength{\rk@ht}{\rk@ta}\fi
  % Platform x bounds
  \setlength{\rk@ta}{\rk@x}\addtolength{\rk@ta}{\rk@halfsep}%          rk@ta = plat_left
  \addtolength{\rk@tc}{\rk@ta}\addtolength{\rk@tc}{\rk@halfsep}%        rk@tc = plat_right
  \setlength{\rk@effmod}{\rk@tc}\addtolength{\rk@effmod}{\rk@halfsep}%  rk@effmod = foot_right
  % post_x = midpoint of platform
  \setlength{\rk@tb}{\rk@ta}\addtolength{\rk@tb}{\rk@tc}\divide\rk@tb by 2\relax  % rk@tb = post_x
  % Y coordinates — triangle scaled to 2/3
  \setlength{\rk@wlevel}{#1}%
  \pgfmathsetlength{\rk@grd@fh}{\the\rk@halfsep * 2 / 3}%    tri height = 2/3 * halfsep
  \addtolength{\rk@wlevel}{\rk@grd@fh}%                        rk@wlevel = apex_y
  \setlength{\rk@grd@maxdepth}{#1}\addtolength{\rk@grd@maxdepth}{\rk@grd@posth}%  rk@grd@maxdepth = plat_y
  % Draw platform, foot, and legs (same as gerund)
  \rk@line{(\the\rk@ta, \the\rk@grd@maxdepth) -- (\the\rk@tc, \the\rk@grd@maxdepth)}%
  \pgfmathsetlength{\rk@grd@fh}{\the\rk@halfsep * 2 / 3 / 1.73205}%  half-base = (2/3)*halfsep/√3
  \setlength{\rk@ta}{\rk@tb}\addtolength{\rk@ta}{-\rk@grd@fh}%
  \rk@line{(\the\rk@x, #1) -- (\the\rk@effmod, #1)}%
  \rk@line{(\the\rk@ta, #1) -- (\the\rk@tb, \the\rk@wlevel)}%
  \rk@line{(\the\dimexpr\rk@tb+\rk@grd@fh\relax, #1) -- (\the\rk@tb, \the\rk@wlevel)}%
  % Draw post with "to" label to its right
  \draw[color=\rk@color, line width=\rk@lw]
    (\the\rk@tb, \the\rk@wlevel) -- (\the\rk@tb, \the\rk@grd@maxdepth)
    node[midway, right, inner sep=2pt, outer sep=0pt, font=\rk@font] {to};%
  % Record slot (mirrors gerund: sl@l = post_x)
  \setlength{\rk@sl@l}{\rk@tb}%
  \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%
  \setlength{\rk@sl@y}{\rk@grd@maxdepth}%
  \setlength{\rk@x}{\rk@effmod}%
  % Place verb on platform (centred at post_x)
  \setlength{\rk@ta}{\rk@grd@maxdepth}\addtolength{\rk@ta}{\rk@wordlift}%
  \node[anchor=base, inner sep=0pt, outer sep=0pt, font=\rk@font]
    at (\the\rk@tb, \the\rk@ta) {\rk@deferredinf@word};%
  % Run verb's modifiers from the platform
  \ifblank{\rk@deferredinf@mods}{}{%
    \rk@slot@to@mc
    \rk@runmods{\rk@deferredinf@mods}%
  }%
  % Update clause miny
  \setlength{\rk@ta}{#1}%
  \ifdim\rk@ta<\rk@clause@miny\global\rk@clause@miny=\rk@ta\fi
}

% \rk@doinfinitiveMod{tail-content}{verb}
% Modifier form: diagonal labeled "to" + horizontal with verb + optional tail.
\newcommand{\rk@doinfinitiveMod}[2]{%
  \rk@extendbase
  % Size the slant on the "to" label
  \node[opacity=0, inner sep=2pt, outer sep=0pt, font=\rk@font]
    (rk@infmsr) at (0,0) {\phantom{to}};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@infmsr}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@infmsr}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%
  \pgfextracty{\rk@tb}{\pgfpointanchor{rk@infmsr}{north}}%
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@infmsr}{south}}%
  \addtolength{\rk@tb}{-\rk@ta}%
  \pgfmathsetlength{\rk@effmod}{max(\the\rk@modDepth,(\the\rk@tc+\the\rk@tb)/1.41422+6pt)}%
  \ifdim\rk@slant@minlen>\rk@effmod\setlength{\rk@effmod}{\rk@slant@minlen}\fi
  \setlength{\rk@slant@minlen}{0pt}%
  % Sibling push when tail is present
  \ifblank{#1}{}{%
    \ifdim\rk@prevmod@E>\rk@modDepth
      \addtolength{\rk@mc@cur}{\rk@prevmod@E}%
      \addtolength{\rk@mc@cur}{-\rk@modDepth}%
    \fi
  }%
  % Slant endpoint
  \setlength{\rk@ta}{\rk@mc@cur}\addtolength{\rk@ta}{\rk@effmod}%  rk@ta = slant_x
  \setlength{\rk@tb}{\rk@mc@y}\addtolength{\rk@tb}{-\rk@effmod}%   rk@tb = slant_y
  \ifdim\rk@tb<\rk@clause@miny\global\rk@clause@miny=\rk@tb\fi
  % Draw slant with "to" label
  \draw[color=\rk@color, line width=\rk@lw]
    (\the\rk@mc@cur,\the\rk@mc@y)--(\the\rk@ta,\the\rk@tb)
    node[midway,above,sloped,inner sep=2pt,outer sep=0pt,font=\rk@font]{to};%
  % Advance sibling cursor
  \ifblank{#1}{%
    \addtolength{\rk@mc@cur}{\rk@modDepth}%
  }{%
    \addtolength{\rk@mc@cur}{\rk@effmod}%
  }%
  \global\rk@prevmod@E=\rk@effmod
  \ifrk@extendbl\rk@extendbase\fi
  % Place verb on horizontal
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font]
    (rk@infvmsr) at (0,0) {\phantom{#2}};%
  \pgfextractx{\rk@effmod}{\pgfpointanchor{rk@infvmsr}{east}}%
  \pgfextractx{\rk@tc}    {\pgfpointanchor{rk@infvmsr}{west}}%
  \addtolength{\rk@effmod}{-\rk@tc}%   rk@effmod = verb_width
  % line_right = slant_x + halfsep + verb_width + halfsep
  \setlength{\rk@tc}{\rk@ta}%
  \addtolength{\rk@tc}{\rk@halfsep}%
  \addtolength{\rk@tc}{\rk@effmod}%
  \addtolength{\rk@tc}{\rk@halfsep}%   rk@tc = line_right
  % With tail: extend for modifier branching room
  \ifblank{#1}{}{%
    \addtolength{\rk@tc}{\rk@spacing}%
  }%
  % centre_x for verb = (slant_x + line_right) / 2
  \setlength{\rk@effmod}{\rk@ta}%
  \addtolength{\rk@effmod}{\rk@tc}%
  \divide\rk@effmod by 2\relax%        rk@effmod = centre_x
  % Draw horizontal and place verb
  \rk@line{(\the\rk@ta,\the\rk@tb)--(\the\rk@tc,\the\rk@tb)}%
  \setlength{\rk@wlevel}{\rk@tb}\addtolength{\rk@wlevel}{\rk@wordlift}%
  \node[anchor=base,inner sep=0pt,outer sep=0pt,font=\rk@font]
    at (\the\rk@effmod,\the\rk@wlevel) {#2};%
  % Update modifier cursor
  \setlength{\rk@mc@cur}{\rk@tc}%
  \ifdim\rk@tc>\rk@mc@d\setlength{\rk@mc@d}{\rk@tc}\fi
  % Execute tail content on the mini-baseline
  \ifblank{#1}{}{%
    \begingroup
      \setlength{\rk@x}{\rk@tc}%
      \setlength{\rk@base@y}{\rk@tb}%
      \setlength{\rk@mc@y}{\rk@tb}%
      \setlength{\rk@mc@d}{\rk@ta}%
      % mc@cur = slant_x + 10% of (line_right − slant_x)
      \setlength{\rk@halfsep}{\rk@tc}\addtolength{\rk@halfsep}{-\rk@ta}%
      \divide\rk@halfsep by 10\relax%
      \setlength{\rk@mc@cur}{\rk@ta}\addtolength{\rk@mc@cur}{\rk@halfsep}%
      \setlength{\rk@ht}{2.2ex}%
      \setlength{\rk@nounmodright}{\rk@ta}%
      \global\rk@prevmod@E=0pt
      #1%
    \endgroup
  }%
}

% \rkInfinitive[arg]{verb}
% Default definition = modifier form (\rk@doinfinitiveMod).
% Inside \rk@placeslot, this is replaced by \rk@deferred@Infinitive
% and the noun form (\rk@doinfinitive) is invoked instead.
\NewDocumentCommand{\rkInfinitive}{O{} m}{%
  \rk@doinfinitiveMod{#1}{#2}%
}

% \rkInfObj[mods]{word}
% Places a direct object on the infinitive mini-baseline.
% Only meaningful inside \rkInfinitive's tail-content argument.
\NewDocumentCommand{\rkInfObj}{O{} m}{%
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
  % \rk@runmods restores mc@cur (group boundary). Advance past the object slot so
  % subsequent tail modifiers (e.g. \rkAdv) don't stack with the object's modifiers.
  \ifdim\rk@x>\rk@mc@cur\setlength{\rk@mc@cur}{\rk@x}\fi
  \ifdim\rk@nounmodright>\rk@mc@cur\setlength{\rk@mc@cur}{\rk@nounmodright}\fi
  \ifdim\rk@x>\rk@mc@d\setlength{\rk@mc@d}{\rk@x}\fi
}

% ============================================================
% PARTICIPLE
% \rk@doparticiple{tail-content}{word}
%
% Draws the hockey-stick shape for a participle:
%   diagonal slanting down-right (word rides on it), followed by
%   a short horizontal stub at the bottom (the elbow).
%
% If tail-content is non-empty it executes in a context where the
% stub is the local baseline.  Use \rkPartObj[mods]{word} to place
% a participial object; \rkAdv and \rkPrep attach as usual.
%
% Used as a modifier (like \rkAdj / \rkAdv) inside the optional
% [mods] argument of \rkSubject, \rkDObj, etc.
% ============================================================

\newcommand{\rk@doparticiple}[2]{%
  % #1 = tail content (may be empty), #2 = participial word on diagonal
  \rk@extendbase
  % Measure the participial word to compute effmod (same formula as \rk@domod)
  \node[opacity=0, inner sep=2pt, outer sep=0pt, font=\rk@font]
    (rk@ptcmsr) at (0,0) {\phantom{#2}};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@ptcmsr}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@ptcmsr}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%   rk@tc = node width
  \pgfextracty{\rk@tb}{\pgfpointanchor{rk@ptcmsr}{north}}%
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@ptcmsr}{south}}%
  \addtolength{\rk@tb}{-\rk@ta}%   rk@tb = node height
  \pgfmathsetlength{\rk@effmod}{max(\the\rk@modDepth, (\the\rk@tc + \the\rk@tb) / 1.41422 + 6pt)}%
  \ifdim\rk@slant@minlen>\rk@effmod\setlength{\rk@effmod}{\rk@slant@minlen}\fi
  \setlength{\rk@slant@minlen}{0pt}%
  % Sibling-push when tail content is present (mirrors \rk@domod with sub-mods)
  \ifblank{#1}{}{%
    \ifdim\rk@prevmod@E>\rk@modDepth
      \addtolength{\rk@mc@cur}{\rk@prevmod@E}%
      \addtolength{\rk@mc@cur}{-\rk@modDepth}%
    \fi
  }%
  % Hockey-stick shape: 45° slant → bezier curve → horizontal stub.
  % k = effmod/5 is the horizontal width of the curve.
  % Segment 1 (45°): (mc@cur, mc@y) → (mc@cur+E−k, mc@y−E+k)   [word label here]
  % Curve (out=-45, in=180): from above to  (mc@cur+E, slant_y)
  % Segment 3 (0°):  horizontal stub from slant end rightward by halfsep
  %
  % Register map after this block:
  %   rk@ta  = slant_x  (= mc@cur + E)
  %   rk@wlevel = slant_y (= mid_y − k·tan22°; matches natural arc endpoint)
  %   rk@tc  = stub_end_x (= slant_x + halfsep)
  %
  % k = effmod/5
  \setlength{\rk@tc}{\rk@effmod}\divide\rk@tc by 5\relax       % rk@tc = k
  % slant_x = mc@cur + effmod
  \setlength{\rk@ta}{\rk@mc@cur}\addtolength{\rk@ta}{\rk@effmod}% rk@ta = slant_x
  % mid_x = slant_x − k  (where 45° line ends and curve begins)
  \setlength{\rk@halfsep}{\rk@ta}\addtolength{\rk@halfsep}{-\rk@tc}% rk@halfsep = mid_x
  % mid_y = mc@y − (E − k)
  \setlength{\rk@tb}{\rk@mc@y}\addtolength{\rk@tb}{-\rk@effmod}\addtolength{\rk@tb}{\rk@tc}% rk@tb = mid_y
  % slant_y = mid_y − k·tan(22°)  (≈ natural arc endpoint for out=-45,in=180 over width k)
  \pgfmathsetlength{\rk@wlevel}{\the\rk@tb - 0.40403 * \the\rk@tc}% rk@wlevel = slant_y
  \ifdim\rk@wlevel<\rk@clause@miny\global\rk@clause@miny=\rk@wlevel\fi
  % Draw 45° slant then bezier curve to the stub (no label on these draw commands).
  \rk@line{(\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@halfsep, \the\rk@tb)}% 45°
  \draw[color=\rk@color, line width=\rk@lw]
    (\the\rk@halfsep, \the\rk@tb) to[out=-45, in=180] (\the\rk@ta, \the\rk@wlevel);% curve
  % Place word label on a dummy 45° \path from start → slant_x (same as \rk@domod).
  % Midpoint = E/2 below the main baseline, preventing overlap for wide words.
  % rk@tb reused for the 45°-end y = mc@y − E.
  \setlength{\rk@tb}{\rk@mc@y}\addtolength{\rk@tb}{-\rk@effmod}%
  \path (\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb)
    node[midway, above, sloped,
         inner sep=2pt, outer sep=0pt, font=\rk@font, color=\rk@color] {#2};%
  % Segment 3: horizontal stub.
  % Use full spacing when tail content is present so mods have room to branch from
  % within the stub; use halfsep for a bare participle (no tail).
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  \setlength{\rk@tc}{\rk@ta}%
  \ifblank{#1}{%
    \addtolength{\rk@tc}{\rk@halfsep}%   bare: short stub
  }{%
    \addtolength{\rk@tc}{\rk@spacing}%   with tail: full-spacing stub
  }%
  \rk@line{(\the\rk@ta, \the\rk@wlevel) -- (\the\rk@tc, \the\rk@wlevel)}%
  % Advance sibling cursor
  \ifblank{#1}{%
    \addtolength{\rk@mc@cur}{\rk@modDepth}%
  }{%
    \addtolength{\rk@mc@cur}{\rk@effmod}%
  }%
  \global\rk@prevmod@E=\rk@effmod
  \ifrk@extendbl\rk@extendbase\fi
  % Execute tail content (participial object + modifiers of the participle)
  \ifblank{#1}{}{%
    \begingroup
      \setlength{\rk@x}{\rk@tc}%            cursor starts at stub_end_x
      \setlength{\rk@base@y}{\rk@wlevel}%  base y = slant_y
      \setlength{\rk@mc@y}{\rk@wlevel}%
      % mc@d = slant_x: \rk@extendbase fires as modifiers advance past the elbow.
      % mc@cur = slant_x + halfsep: first modifier branches from the stub midpoint,
      % leaving the right half of the stub visible past the attachment point.
      \setlength{\rk@mc@d}{\rk@ta}%
      \setlength{\rk@mc@cur}{\rk@ta}\addtolength{\rk@mc@cur}{\rk@halfsep}%
      \setlength{\rk@ht}{2.2ex}%
      \setlength{\rk@nounmodright}{\rk@ta}%
      \global\rk@prevmod@E=0pt
      #1%
      % The tail hangs below the main baseline — its horizontal extent must NOT inflate
      % rk@nounmodright, which controls the main-baseline extension before \rk@divfull.
    \endgroup
  }%
}

% \rkParticiple[tail-content]{word}
% Modifier command: attaches a participle to a noun via the hockey-stick shape.
\NewDocumentCommand{\rkParticiple}{O{} m}{%
  \rk@doparticiple{#1}{#2}%
}

% \rkPartObj[mods]{word}
% Places a participial object on the horizontal tail of \rkParticiple.
% Only meaningful inside \rkParticiple's tail-content argument.
\NewDocumentCommand{\rkPartObj}{O{} m}{%
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
  % Advance mc@cur past the object slot so subsequent tail modifiers don't
  % stack with the object's own modifiers (same fix as \rkInfObj).
  \ifdim\rk@x>\rk@mc@cur\setlength{\rk@mc@cur}{\rk@x}\fi
  \ifdim\rk@nounmodright>\rk@mc@cur\setlength{\rk@mc@cur}{\rk@nounmodright}\fi
  \ifdim\rk@x>\rk@mc@d\setlength{\rk@mc@d}{\rk@x}\fi
}

% ============================================================
% NOMINATIVE ABSOLUTE
% \rkNomAbs[noun-mods]{noun}{ptcl-tail}{ptcl-word}
%
% Draws a nominative absolute phrase floating ABOVE the main
% clause with no connector.  Call before or after other clause
% commands — placement is always at a fixed height above y=0.
%
% The phrase has two parts:
%   noun        — placed on a short horizontal baseline
%   participle  — hangs below the noun via the standard
%                 hockey-stick (uses \rkParticiple internally)
%
%   [noun-mods]  optional modifiers of the noun (e.g. \rkAdj)
%   {noun}       the noun of the absolute phrase
%   {ptcl-tail}  tail content for the participle; pass {} for none
%                (\rkPartObj, \rkAdv, \rkPrep, etc.)
%   {ptcl-word}  the participial word (pass {} for no participle,
%                e.g. for a "with implied being" absolute)
% ============================================================

\newcommand{\rk@donominabs}[4]{%
  % #1 = noun-mods, #2 = noun, #3 = ptcl-tail, #4 = ptcl-word
  % NA baseline y: use \rkNomAbsHeight override if set, else subClDepth
  \ifdim\rk@nomabs@height>0pt
    \setlength{\rk@tb}{\rk@base@y}\addtolength{\rk@tb}{\rk@nomabs@height}%
    \setlength{\rk@nomabs@height}{0pt}%
  \else
    \setlength{\rk@tb}{\rk@base@y}\addtolength{\rk@tb}{\rk@subClDepth}%
  \fi
  % Save outer verb x (mirrors \rk@dosubclause pattern)
  \global\rk@sc@saved@vb@r=\rk@vb@r
  \begingroup
    \setlength{\rk@x}{0pt}%
    \setlength{\rk@base@y}{\rk@tb}%
    \setlength{\rk@mc@y}{\rk@tb}%
    \setlength{\rk@mc@d}{0pt}%
    \setlength{\rk@mc@cur}{0pt}%
    \setlength{\rk@ht}{2.2ex}%
    \setlength{\rk@nounmodright}{0pt}%
    \global\rk@prevmod@E=0pt
    % Place noun on the NA baseline
    \rk@placeslot{#2}{\the\rk@base@y}%
    \rk@slot@to@mc
    % Run noun-mods then the participle (empty ptcl-word skips the participle)
    \ifblank{#4}{%
      \ifblank{#1}{}{\rk@runmods{#1}}%
    }{%
      \rk@runmods{#1,\rkParticiple[#3]{#4}}%
    }%
  \endgroup
  \global\rk@vb@r=\rk@sc@saved@vb@r
}

% \rkNomAbs[noun-mods]{noun}{ptcl-tail}{ptcl-word}
\NewDocumentCommand{\rkNomAbs}{O{} m m m}{%
  \rk@donominabs{#1}{#2}{#3}{#4}%
}

\endinput
