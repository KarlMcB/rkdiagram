%%
%% rkdiagram.sty  —  Reed-Kellogg sentence diagrams for LaTeX
%% Version 1.0  |  Requires LuaLaTeX or pdfLaTeX + TikZ
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rkdiagram}[2026/04/27 v1.0 Reed-Kellogg sentence diagrams]

\RequirePackage{tikz}
\usetikzlibrary{calc,positioning}
\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{pgfopts}

% Execute a modifier/submod token list, stripping catcode-12 commas first.
% (Commas are used as cosmetic separators in [mod, mod, ...] lists.)
% Defined inside \ExplSyntaxOn so expl3 primitives work, but the command
% name \rk@execmods contains no colon, so it is callable outside expl3 mode.
\ExplSyntaxOn
\newcommand{\rk@execmods}[1]{%
  \tl_set:Nn \l_tmpa_tl {#1}%
  \tl_remove_all:Nn \l_tmpa_tl {,}%
  \tl_use:N \l_tmpa_tl
}
\ExplSyntaxOff

% ============================================================
% CONFIGURATION LENGTHS AND FLAGS
% ============================================================

\newlength{\rk@spacing}    \setlength{\rk@spacing}{1.2cm}
\newlength{\rk@modDepth}   \setlength{\rk@modDepth}{1.0cm}
\newlength{\rk@modgap}     \setlength{\rk@modgap}{0.25cm}
\newlength{\rk@cmpsep}     \setlength{\rk@cmpsep}{0pt}  % 0pt = auto (use rk@ht)
\newlength{\rk@subClDepth} \setlength{\rk@subClDepth}{2.5cm}
\newlength{\rk@gerundpost}  \setlength{\rk@gerundpost}{1.2cm}
\newlength{\rk@grd@posth@force} \setlength{\rk@grd@posth@force}{0pt}  % 0 = adaptive
\newlength{\rk@grd@shelfext}    \setlength{\rk@grd@shelfext}{0pt}     % extra lower-shelf width
\newlength{\rk@lw}         \setlength{\rk@lw}{0.4pt}
\newcommand{\rk@color}{black}
\newcommand{\rk@font}{}

\pgfkeys{
  /rkdiagram/.is family, /rkdiagram,
  font/.code           = {\renewcommand{\rk@font}{#1}},
  spacing/.code        = {\setlength{\rk@spacing}{#1}},
  modDepth/.code       = {\setlength{\rk@modDepth}{#1}},
  modgap/.code         = {\setlength{\rk@modgap}{#1}},
  cmpSep/.code         = {\setlength{\rk@cmpsep}{#1}},
  subClauseDepth/.code  = {\setlength{\rk@subClDepth}{#1}},
  gerundPost/.code      = {\setlength{\rk@gerundpost}{#1}},
  gerundPostH/.code     = {\setlength{\rk@grd@posth@force}{#1}},
  gerundShelfExt/.code  = {\setlength{\rk@grd@shelfext}{#1}},
  linewidth/.code      = {\setlength{\rk@lw}{#1}},
  color/.code          = {\renewcommand{\rk@color}{#1}},
  bridgeY/.code        = {\setlength{\rk@bridgey@override}{#1}},
}

\ProcessPgfOptions{/rkdiagram}

% \rkset{key=val,...} — override defaults mid-document
\newcommand{\rkset}[1]{\pgfkeys{/rkdiagram, #1}}

% ============================================================
% INTERNAL STATE
% ============================================================

% Set to true by \rkCompoundSent so the rkdiagram env skips the tikzpicture wrapper.
\newif\ifrk@intikz  \rk@intikzfalse

\newlength{\rk@x}      % main baseline x cursor
\newlength{\rk@ht}     % running max word height (used for divider length)
\newlength{\rk@clause@miny}       % lowest y reached during current clause (for bridge placement)
\newlength{\rk@sc@saved@vb@r}    % saves outer verb x across \rk@dosubclause (global write bleeds)
\newlength{\rk@cmpst@saved@miny}  % clause 1 miny saved before clause 2 is drawn
\newlength{\rk@bridgey@override}  % manual bridge y override (0pt = auto)

% Current slot — set by \rk@placeslot
\newlength{\rk@sl@l}   % left x
\newlength{\rk@sl@r}   % right x
\newlength{\rk@sl@d}   % drawn right x (for baseline extension)
\newlength{\rk@sl@y}   % y level

% Verb slot — saved separately so \rkIObj can attach to it
\newlength{\rk@vb@l}
\newlength{\rk@vb@r}
\newlength{\rk@vb@y}

% Right edge of the indirect-object platform (global; checked after \rk@doiobj)
\newlength{\rk@iobj@xmax}

% Saved verb word text (for re-centering after \rkIObj widens the slot)
\newcommand{\rk@vb@word}{}

% Saved subject word + slot bounds (for re-centering when noun-mod overhang widens the slot)
\newcommand{\rk@subj@word}{}
\newlength{\rk@subj@l}
\newlength{\rk@subj@r}
% Set true when an appositive is placed on the subject (suppresses re-centering).
\newif\ifrk@subj@appos  \rk@subj@apposfalse

% Effective mod depth for a single modifier (may exceed \rk@modDepth for wide words)
\newlength{\rk@effmod}

% Sibling-push: E of the most recently drawn modifier at this level (reset by \rk@runmods).
% Used to push a modifier-with-sub-modifiers right when preceded by a longer sibling,
% so the sub-modifier connector does not land in the preceding slant's territory.
\newlength{\rk@prevmod@E}  \setlength{\rk@prevmod@E}{0pt}

% Modifier context — saved/restored via \begingroup
\newlength{\rk@mc@y}    % head y level
\newlength{\rk@mc@d}    % head drawn-right x
\newlength{\rk@mc@cur}  % attachment cursor x

% Rightmost x reached by the most recent \rk@runmods call (global; used by \rk@divfull)
\newlength{\rk@nounmodright}

% Per-slot overrides (one-shot: applied once then auto-reset to 0pt)
\newlength{\rk@slot@minwidth}  % minimum line width for next slot (0pt = auto)
\newlength{\rk@slot@skip}      % extra gap inserted before next slot (0pt = none)
\newlength{\rk@slant@minlen}   % minimum slant length for next modifier/prep (0pt = auto)
\newlength{\rk@nomabs@height}  % height override for next \rkNomAbs (0pt = use subClDepth)

% Scratch length registers (\newlength = \newdimen, safe for \pgfextractx)
\newlength{\rk@ta}
\newlength{\rk@tb}
\newlength{\rk@tc}
\newlength{\rk@halfsep}

% Saved compound modifier context (text start x, platform right x, csep, centre y)
\newlength{\rk@cmp@textx}
\newlength{\rk@cmp@platright}
\newlength{\rk@cmp@csep}
\newlength{\rk@cmp@basey}   % outer rk@base@y at time docompound is called
\newlength{\rk@cmp@wa}      % width of compound word A (for centring)
\newlength{\rk@cmp@wb}      % width of compound word B (for centring)

% Current baseline y-level; 0pt on the main baseline, overridden in sub-clauses
\newlength{\rk@base@y}

% Word-lift: distance to raise word nodes above their platform line
% so descenders never touch the line.  Measured once per rkdiagram.
\newlength{\rk@wordlift}
\newlength{\rk@wlevel}   % scratch: line_y + wordlift, used at each word placement

% Deferred gerund — used when \rkGerund appears as a word argument.
\newif\ifrk@deferredgrd  \rk@deferredgrdfalse
\newcommand{\rk@deferredgrd@word}{}
\newcommand{\rk@deferredgrd@mods}{}
\NewDocumentCommand{\rk@deferred@Gerund}{O{} m}{%
  \global\rk@deferredgrdtrue
  \gdef\rk@deferredgrd@mods{#1}%
  \gdef\rk@deferredgrd@word{#2}%
}

% Scratch lengths used during gerund modifier pre-measurement and drawing.
\newlength{\rk@grd@maxdepth}  % deepest modifier slant found in the pre-scan
\newlength{\rk@grd@posth}     % computed post height for the current gerund
\newlength{\rk@grd@fh}        % equilateral-triangle half-base (= apex_height / sqrt(3))
\newlength{\rk@grd@wordw}     % saved gerund word width (for stepped-shape geometry)

% Deferred infinitive — used when \rkInfinitive appears as a word argument.
\newif\ifrk@deferredinf  \rk@deferredinffalse
\newcommand{\rk@deferredinf@word}{}
\newcommand{\rk@deferredinf@mods}{}
\NewDocumentCommand{\rk@deferred@Infinitive}{O{} m}{%
  \global\rk@deferredinftrue
  \gdef\rk@deferredinf@mods{#1}%
  \gdef\rk@deferredinf@word{#2}%
}

% Deferred subclause — used when \rkSubClause appears as a word argument.
% The drawing is deferred until after the (empty) slot node is placed.
\newif\ifrk@deferredsc  \rk@deferredscfalse
\newif\ifrk@extendbl    \rk@extendblfalse   % true only while processing word-level mods
\newcommand{\rk@deferredsc@rw}{}
\newcommand{\rk@deferredsc@body}{}
\newcommand{\rk@deferred@SubClause}[2][]{%
  \global\rk@deferredsctrue
  \gdef\rk@deferredsc@rw{#1}%
  \gdef\rk@deferredsc@body{#2}%
}

% Deferred compound — used when \rkCompound appears as a word argument.
% \rk@cmpdir is set by each slot command before calling \rk@placeslot.
\newif\ifrk@deferredcmp  \rk@deferredcmpfalse
\newcommand{\rk@deferredcmp@conj}{and}
\newcommand{\rk@deferredcmp@modsa}{}
\newcommand{\rk@deferredcmp@worda}{}
\newcommand{\rk@deferredcmp@modsb}{}
\newcommand{\rk@deferredcmp@wordb}{}
% Signature: [conj][mods_a]{word_a}[mods_b]{word_b}
\NewDocumentCommand{\rk@deferred@Compound}{O{and} O{} m O{} m}{%
  \global\rk@deferredcmptrue
  \gdef\rk@deferredcmp@conj{#1}%
  \gdef\rk@deferredcmp@modsa{#2}%
  \gdef\rk@deferredcmp@worda{#3}%
  \gdef\rk@deferredcmp@modsb{#4}%
  \gdef\rk@deferredcmp@wordb{#5}%
}
\def\rk@cmpdir{l}   % default; overridden by each slot command

% ============================================================
% DRAW SHORTHAND
% ============================================================

\newcommand{\rk@line}[1]{%
  \draw[color=\rk@color, line width=\rk@lw] #1;%
}

% ============================================================
% PLACE A WORD ON A BASELINE SLOT
% \rk@placeslot{word}{y}
% Draws the word node + baseline segment; records slot; advances \rk@x.
% ============================================================

\newcommand{\rk@placeslot}[2]{%
  \global\rk@deferredscfalse
  \global\rk@deferredcmpfalse
  \global\rk@deferredgrdfalse
  \global\rk@deferredinffalse
  \setlength{\rk@halfsep}{\rk@spacing}%
  \divide\rk@halfsep by 2\relax
  % Apply per-slot skip (extends baseline, advances cursor, then resets).
  \ifdim\rk@slot@skip>0pt
    \setlength{\rk@ta}{\rk@x}\addtolength{\rk@ta}{\rk@slot@skip}%
    \rk@line{(\the\rk@x, #2) -- (\the\rk@ta, #2)}%
    \setlength{\rk@x}{\rk@ta}%
    \setlength{\rk@slot@skip}{0pt}%
  \fi
  % Lift word above the baseline line so descenders clear it.
  \setlength{\rk@wlevel}{#2}\addtolength{\rk@wlevel}{\rk@wordlift}%
  % Step 1: measure word width and detect deferred \rkSubClause / \rkCompound / \rkGerund.
  \begingroup
    \let\rkSubClause\rk@deferred@SubClause
    \let\rkCompound\rk@deferred@Compound
    \let\rkGerund\rk@deferred@Gerund
    \let\rkInfinitive\rk@deferred@Infinitive
    \node[
      opacity   = 0,
      inner sep = 0pt,
      outer sep = 0pt,
      font      = \rk@font,
    ] (rk@wnode) at (0, 0) {\phantom{#1}};%
  \endgroup
  \ifrk@deferredgrd
    % Gerund: draw stepped-platform structure.
    \rk@dogerund{#2}%
    \global\rk@deferredgrdfalse
  \else\ifrk@deferredinf
    % Infinitive (noun form): pedestal + "to" post + verb platform.
    \rk@doinfinitive{#2}%
    \global\rk@deferredinffalse
  \else\ifrk@deferredcmp
    % Compound: draw compound structure (rk@x is the compound start).
    \rk@docompound{\rk@cmpdir}%
      {\rk@deferredcmp@conj}%
      {\rk@deferredcmp@modsa}{\rk@deferredcmp@worda}%
      {\rk@deferredcmp@modsb}{\rk@deferredcmp@wordb}%
    \global\rk@deferredcmpfalse
  \else
    % Normal word: compute centred position, draw baseline, place word, record slot.
    % word_width = east − west of measurement node
    \pgfextractx{\rk@tb}{\pgfpointanchor{rk@wnode}{east}}%
    \pgfextractx{\rk@ta}{\pgfpointanchor{rk@wnode}{west}}%
    \addtolength{\rk@tb}{-\rk@ta}%        rk@tb = word_width
    % line_right = rk@x + halfsep + word_width + halfsep
    \setlength{\rk@ta}{\rk@x}%
    \addtolength{\rk@ta}{\rk@halfsep}%
    \addtolength{\rk@ta}{\rk@tb}%
    \addtolength{\rk@ta}{\rk@halfsep}%    rk@ta = line right edge (auto)
    % Apply minwidth override: line must be at least rk@x + rk@slot@minwidth
    \ifdim\rk@slot@minwidth>0pt
      \setlength{\rk@tc}{\rk@x}\addtolength{\rk@tc}{\rk@slot@minwidth}%
      \ifdim\rk@tc>\rk@ta\setlength{\rk@ta}{\rk@tc}\fi
      \setlength{\rk@slot@minwidth}{0pt}%  reset after use
    \fi
    % centre_x  = rk@x + halfsep + word_width/2
    \divide\rk@tb by 2\relax%             rk@tb = word_width/2
    \setlength{\rk@tc}{\rk@x}%
    \addtolength{\rk@tc}{\rk@halfsep}%
    \addtolength{\rk@tc}{\rk@tb}%         rk@tc = centre_x
    % Update rk@ht (north y from measurement node)
    \pgfextracty{\rk@tb}{\pgfpointanchor{rk@wnode}{north}}%
    \ifdim\rk@tb>\rk@ht \setlength{\rk@ht}{\rk@tb}\fi
    % Draw baseline, then place visible centred word node.
    \rk@line{(\the\rk@x, #2) -- (\the\rk@ta, #2)}%
    \begingroup
      \let\rkSubClause\rk@deferred@SubClause
      \let\rkCompound\rk@deferred@Compound
      \node[
        anchor    = base,
        inner sep = 0pt,
        outer sep = 0pt,
        font      = \rk@font,
      ] (rk@wnode) at (\the\rk@tc, \the\rk@wlevel) {#1};%
    \endgroup
    % Record slot registers.
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@ta}\setlength{\rk@sl@d}{\rk@ta}%
    \setlength{\rk@sl@y}{#2}\setlength{\rk@x}{\rk@ta}%
    \ifrk@deferredsc
      \rk@slot@to@mc
      \rk@dosubclause{\rk@deferredsc@rw}{\rk@deferredsc@body}%
      \global\rk@deferredscfalse
    \fi
  \fi\fi\fi
}

% Set modifier context from current slot.
% First modifier attaches 10% along the word's baseline (not at the very start).
\newcommand{\rk@slot@to@mc}{%
  \setlength{\rk@mc@y}{\rk@sl@y}%
  \setlength{\rk@mc@d}{\rk@sl@d}%
  \setlength{\rk@ta}{\rk@sl@r}%
  \addtolength{\rk@ta}{-\rk@sl@l}%      % rk@ta = slot width
  \divide\rk@ta by 10\relax              % rk@ta = 10% of slot width
  \setlength{\rk@mc@cur}{\rk@sl@l}%
  \addtolength{\rk@mc@cur}{\rk@ta}%     % mc@cur = sl@l + 10%
}

% ============================================================
% DIVIDERS
% ============================================================

% Full vertical bar  (subject | verb) — symmetric around baseline.
% Advances rk@x past any noun modifier overhang before drawing, so both
% the divider and the verb slot sit to the right of all noun modifier slants.
\newcommand{\rk@divfull}{%
  \ifdim\rk@nounmodright>\rk@x
    \rk@line{(\the\rk@x, \the\rk@base@y) -- (\the\rk@nounmodright, \the\rk@base@y)}%
    \setlength{\rk@x}{\rk@nounmodright}%
    % Re-centre subject word in the now-wider slot [subj@l … rk@x].
    % Skip if an appositive is present — the word is correctly left-positioned
    % and the appositive text occupies the right portion of the slot.
    \ifrk@subj@appos\else\ifblank{\rk@subj@word}{}{%
      \setlength{\rk@tb}{\rk@base@y}\addtolength{\rk@tb}{\rk@ht}\addtolength{\rk@tb}{4pt}%
      \fill[white] (\the\rk@subj@l, \the\rk@base@y) rectangle (\the\rk@subj@r, \the\rk@tb);%
      \setlength{\rk@ta}{\rk@subj@l}\addtolength{\rk@ta}{\rk@x}\divide\rk@ta by 2\relax
      \setlength{\rk@wlevel}{\rk@base@y}\addtolength{\rk@wlevel}{\rk@wordlift}%
      \node[anchor=base, inner sep=0pt, outer sep=0pt, font=\rk@font]
        at (\the\rk@ta, \the\rk@wlevel) {\rk@subj@word};%
      \rk@line{(\the\rk@subj@l, \the\rk@base@y) -- (\the\rk@x, \the\rk@base@y)}%
      \gdef\rk@subj@word{}%
    }\fi
  \fi
  \setlength{\rk@ta}{\rk@ht}%
  \addtolength{\rk@ta}{0.18cm}%
  % Top of bar: base_y + rk@ta  (full ascender)
  \setlength{\rk@tc}{\rk@base@y}\addtolength{\rk@tc}{\rk@ta}%
  % Bottom of bar: base_y − rk@ta/2  (half descender)
  \divide\rk@ta by 2\relax%
  \setlength{\rk@tb}{\rk@base@y}\addtolength{\rk@tb}{-\rk@ta}%
  \rk@line{(\the\rk@x, \the\rk@tb) -- (\the\rk@x, \the\rk@tc)}%
}

% Short vertical bar  (verb | direct object)
\newcommand{\rk@divshort}{%
  \setlength{\rk@ta}{\rk@ht}%
  \addtolength{\rk@ta}{0.10cm}%
  \addtolength{\rk@ta}{\rk@base@y}%
  \rk@line{(\the\rk@x, \the\rk@base@y) -- (\the\rk@x, \the\rk@ta)}%
}

% Back diagonal  (verb \ predNom or predAdj) — bottom touches baseline, slants up-left
\newcommand{\rk@divfwd}{%
  \setlength{\rk@ta}{\rk@ht}%
  \addtolength{\rk@ta}{0.18cm}%
  \pgfmathsetlength{\rk@tb}{\the\rk@ta / tan(45)}%
  \rk@line{(\the\rk@x, \the\rk@base@y) -- ++(-\the\rk@tb, \the\rk@ta)}%
}

% ============================================================
% MODIFIER DRAWING
% ============================================================

% \rk@extendbase — draw a baseline extension from drawn edge to cursor.
\newcommand{\rk@extendbase}{%
  \ifdim\rk@mc@cur>\rk@mc@d
    \rk@line{(\the\rk@mc@d, \the\rk@mc@y) -- (\the\rk@mc@cur, \the\rk@mc@y)}%
    \setlength{\rk@mc@d}{\rk@mc@cur}%
  \fi
}

% \rk@domod{word}{submods}
% Draw one modifier slant (always down-right), then recurse into sub-modifiers.
%
% Sub-modifier geometry (matching example: adjective (0,0)→(10,−10),
% connector (2,−2)→(0,−4), adverb (0,−4)→(8,−12)):
%   • The connector branches off the parent slant at 20% of the way along
%     (i.e., at x_s + 0.2·E, y_s − 0.2·E) and goes diagonally down-left
%     back to the parent's starting x (x_s, y_s − 0.4·E).
%   • The child slant then continues down-right from (x_s, y_s − 0.4·E).
\newcommand{\rk@domod}[2]{%
  \rk@extendbase
  \node[opacity=0, inner sep=2pt, outer sep=0pt, font=\rk@font]
    (rk@modmsr) at (0,0) {\phantom{#1}};%
  % Measure width (east − west)
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@modmsr}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@modmsr}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%   % rk@tc = nodeWidth
  % Measure height (north − south)
  \pgfextracty{\rk@tb}{\pgfpointanchor{rk@modmsr}{north}}%
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@modmsr}{south}}%
  \addtolength{\rk@tb}{-\rk@ta}%   % rk@tb = nodeHeight
  \pgfmathsetlength{\rk@effmod}{max(\the\rk@modDepth, (\the\rk@tc + \the\rk@tb) / 1.41422 + 6pt)}%
  % Apply per-slant minimum override, then reset.
  \ifdim\rk@slant@minlen>\rk@effmod\setlength{\rk@effmod}{\rk@slant@minlen}\fi
  \setlength{\rk@slant@minlen}{0pt}%
  % Sub-modifier sibling push: if this modifier has sub-modifiers and the preceding
  % sibling's slant extended past the standard modDepth step, push mc@cur forward
  % so the sub-modifier connector clears the preceding slant's territory.
  % (Plain adjectives always step by modDepth, so prev_E − modDepth is the overhang.)
  \ifblank{#2}{}{%
    \ifdim\rk@prevmod@E>\rk@modDepth
      \addtolength{\rk@mc@cur}{\rk@prevmod@E}%
      \addtolength{\rk@mc@cur}{-\rk@modDepth}%
    \fi
  }%
  % Slant: (mc@cur, mc@y) → (mc@cur + E, mc@y − E)
  \setlength{\rk@ta}{\rk@mc@cur}%
  \addtolength{\rk@ta}{\rk@effmod}%    % rk@ta = endpoint x = x_s + E
  \setlength{\rk@tb}{\rk@mc@y}%
  \addtolength{\rk@tb}{-\rk@effmod}%   % rk@tb = endpoint y = y_s − E
  \ifdim\rk@tb<\rk@clause@miny\global\rk@clause@miny=\rk@tb\fi
  \draw[color=\rk@color, line width=\rk@lw]
    (\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb)
    node[midway, above, sloped,
         inner sep=2pt, outer sep=0pt, font=\rk@font] {#1};%
  % Advance sibling cursor:
  %   • Modifier WITH sub-modifiers: advance by full effmod (sub-modifier needs the room).
  %   • Plain modifier (no sub-modifiers): advance by modDepth only — equal spacing
  %     regardless of word length; long words just produce deeper slants.
  \ifblank{#2}{%
    \addtolength{\rk@mc@cur}{\rk@modDepth}%
  }{%
    \addtolength{\rk@mc@cur}{\rk@effmod}%
  }%
  \global\rk@prevmod@E=\rk@effmod   % record actual E for the next sibling's push check
  \ifrk@extendbl \rk@extendbase \fi
  % Sub-modifiers: connector branches off at 20% along the parent slant,
  % goes diagonally down-left back to the parent's start x, then child
  % slants continue down-right from that lower anchor point.
  \ifblank{#2}{}{%
    \begingroup
      \global\rk@prevmod@E=0pt   % reset sibling-push tracking for child modifier level
      % a = max(cap-height, 0.2·E) so child level is always at least one cap-height below parent
      \node[opacity=0, inner sep=0pt, outer sep=0pt, font=\rk@font]
        (rk@capmsr) at (0,0) {\phantom{M}};%
      \pgfextracty{\rk@halfsep}{\pgfpointanchor{rk@capmsr}{north}}%
      \pgfextracty{\rk@ta}{\pgfpointanchor{rk@capmsr}{south}}%
      \addtolength{\rk@halfsep}{-\rk@ta}%   % rk@halfsep = cap-height of font
      \pgfmathsetlength{\rk@halfsep}{max(\the\rk@halfsep, 0.2 * \the\rk@effmod)}%
      \addtolength{\rk@halfsep}{\rk@modgap}% extra headspace between modifier levels
      % x_s = parent start x = (mc@cur after advance) − E
      \setlength{\rk@tc}{\rk@mc@cur}%
      \addtolength{\rk@tc}{-\rk@effmod}%      % rk@tc = x_s
      % Connector attachment on parent slant: (x_s + a, y_s − a)
      \setlength{\rk@ta}{\rk@tc}%
      \addtolength{\rk@ta}{\rk@halfsep}%      % attachment x = x_s + a
      \setlength{\rk@tb}{\rk@mc@y}%
      \addtolength{\rk@tb}{-\rk@halfsep}%     % attachment y = y_s − a
      % Connector endpoint (= child anchor): (x_s + modgap, y_s − 2a)
      % modgap shifts child right so it clears the previous sibling's slant region
      \addtolength{\rk@mc@y}{-\rk@halfsep}%
      \addtolength{\rk@mc@y}{-\rk@halfsep}%   % mc@y = y_s − 2a
      \addtolength{\rk@tc}{\rk@modgap}%        % rk@tc = x_s + modgap
      % Draw connector: (x_s+a, y_s−a) → (x_s+modgap, y_s−2a)
      \rk@line{(\the\rk@ta, \the\rk@tb) -- (\the\rk@tc, \the\rk@mc@y)}%
      % Child context: cursor at x_s + modgap, level at y_s − 2a; disable baseline extension
      \setlength{\rk@mc@cur}{\rk@tc}%
      \setlength{\rk@mc@d}{\rk@tc}%
      \rk@extendblfalse
      \rk@execmods{#2}%
    \endgroup
  }%
}

% Execute a modifier list (commas are stripped, then tokens run).
\newcommand{\rk@runmods}[1]{%
  \ifblank{#1}{}{%
    \begingroup
      \global\rk@prevmod@E=0pt   % reset sibling-push tracking for this modifier list
      \rk@extendbltrue   % word-level: baseline extension enabled
      \rk@execmods{#1}%
      % Max-update: preserve any deeper extent propagated by sub-mod groups
      \ifdim\rk@mc@d>\rk@nounmodright\global\rk@nounmodright=\rk@mc@d\fi
    \endgroup
  }%
}

% ============================================================
% PREP PHRASE DRAWING
% \rk@doprep{mods-on-obj}{prep}{obj}
% Called in mc context. Draws diagonal with prep label, then horizontal with obj.
% ============================================================

\newcommand{\rk@doprep}[3]{%
  % Extend head baseline to cursor
  \rk@extendbase
  % Measure prep label to size the slant (same formula as \rk@domod)
  \node[opacity=0, inner sep=2pt, outer sep=0pt, font=\rk@font]
    (rk@prepmsr) at (0,0) {\phantom{#2}};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@prepmsr}{east}}%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@prepmsr}{west}}%
  \addtolength{\rk@tc}{-\rk@ta}%   % rk@tc = nodeWidth
  \pgfextracty{\rk@tb}{\pgfpointanchor{rk@prepmsr}{north}}%
  \pgfextracty{\rk@ta}{\pgfpointanchor{rk@prepmsr}{south}}%
  \addtolength{\rk@tb}{-\rk@ta}%   % rk@tb = nodeHeight
  \pgfmathsetlength{\rk@effmod}{max(\the\rk@modDepth, (\the\rk@tc + \the\rk@tb) / 1.41422 + 6pt)}%
  % Apply per-slant minimum override, then reset.
  \ifdim\rk@slant@minlen>\rk@effmod\setlength{\rk@effmod}{\rk@slant@minlen}\fi
  \setlength{\rk@slant@minlen}{0pt}%
  % Slant end: (cursor + effmod, y_head - effmod)
  \setlength{\rk@ta}{\rk@mc@cur}%
  \addtolength{\rk@ta}{\rk@effmod}%
  \setlength{\rk@tb}{\rk@mc@y}%
  \addtolength{\rk@tb}{-\rk@effmod}%
  \ifdim\rk@tb<\rk@clause@miny\global\rk@clause@miny=\rk@tb\fi
  % Draw slant with prep label above it at midpoint
  \draw[color=\rk@color, line width=\rk@lw]
    (\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb)
    node[midway, above, sloped,
         inner sep=2pt, outer sep=0pt, font=\rk@font] {#2};%
  % Object: detect \rkCompound for compound fork, else draw single object on horizontal.
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  \global\rk@deferredcmpfalse
  \begingroup
    \let\rkCompound\rk@deferred@Compound
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@pobjnode) at (0,0) {\phantom{#3}};%
  \endgroup
  \ifrk@deferredcmp
    % Compound object: fork centred on slant end (rk@ta, rk@tb)
    \setlength{\rk@x}{\rk@ta}%
    \setlength{\rk@base@y}{\rk@tb}%
    \setlength{\rk@ht}{2.2ex}%
    \rk@docompound{l}{\rk@deferredcmp@conj}%
      {\rk@deferredcmp@modsa}{\rk@deferredcmp@worda}%
      {\rk@deferredcmp@modsb}{\rk@deferredcmp@wordb}%
    \global\rk@deferredcmpfalse
    \setlength{\rk@mc@cur}{\rk@x}%
    \ifdim\rk@x>\rk@mc@d \setlength{\rk@mc@d}{\rk@x}\fi
  \else
    % Normal single object: measure then place centred on horizontal from slant end.
    % rk@ta = slant_end_x, rk@tb = slant_end_y (preserved throughout).
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font]
      (rk@pobjnode) at (0,0) {\phantom{#3}};%
    % word_width = east − west of measurement node
    \pgfextractx{\rk@effmod}{\pgfpointanchor{rk@pobjnode}{east}}%
    \pgfextractx{\rk@tc}    {\pgfpointanchor{rk@pobjnode}{west}}%
    \addtolength{\rk@effmod}{-\rk@tc}%       rk@effmod = word_width
    % line_right = rk@ta + halfsep + word_width + halfsep
    \setlength{\rk@tc}{\rk@ta}%
    \addtolength{\rk@tc}{\rk@halfsep}%
    \addtolength{\rk@tc}{\rk@effmod}%
    \addtolength{\rk@tc}{\rk@halfsep}%       rk@tc = line_right
    % centre_x = (line_left + line_right) / 2 = (rk@ta + rk@tc) / 2
    \setlength{\rk@effmod}{\rk@ta}%
    \addtolength{\rk@effmod}{\rk@tc}%
    \divide\rk@effmod by 2\relax%            rk@effmod = centre_x
    % Draw horizontal line from slant end to line_right.
    \rk@line{(\the\rk@ta, \the\rk@tb) -- (\the\rk@tc, \the\rk@tb)}%
    % Place visible word centred on the line.
    \setlength{\rk@wlevel}{\rk@tb}\addtolength{\rk@wlevel}{\rk@wordlift}%
    \node[
      anchor    = base,
      inner sep = 0pt,
      outer sep = 0pt,
      font      = \rk@font,
    ] (rk@pobjnode) at (\the\rk@effmod, \the\rk@wlevel) {#3};%

    \setlength{\rk@mc@cur}{\rk@tc}%
    \ifdim\rk@tc>\rk@mc@d \setlength{\rk@mc@d}{\rk@tc}\fi
    \ifblank{#1}{}{%
      \begingroup
        \setlength{\rk@mc@y}{\rk@tb}%
        \setlength{\rk@mc@d}{\rk@tc}%          drawn right = line_right
        % mc@cur = line_left + 10% of line_width  (mirrors \rk@slot@to@mc)
        \setlength{\rk@halfsep}{\rk@tc}%
        \addtolength{\rk@halfsep}{-\rk@ta}%     halfsep = line_width
        \divide\rk@halfsep by 10\relax%          halfsep = 10% of line_width
        \setlength{\rk@mc@cur}{\rk@ta}%
        \addtolength{\rk@mc@cur}{\rk@halfsep}%  mc@cur = line_left + 10%
        \rk@execmods{#1}%
        \ifdim\rk@mc@d>\rk@nounmodright\global\rk@nounmodright=\rk@mc@d\fi
      \endgroup
    }%
  \fi
}

% ============================================================
% INDIRECT OBJECT PLATFORM
% Draws below the VERB slot: diagonal then horizontal.
% ============================================================

\newcommand{\rk@doiobj}[2]{%
  % Attach below the verb slot center.
  % Advances \rk@x if the platform extends past the current cursor.
  \begingroup
    \setlength{\rk@mc@y}{\rk@vb@y}%
    \setlength{\rk@mc@d}{\rk@vb@r}%
    % Attachment x = midpoint of verb slot
    \setlength{\rk@mc@cur}{\rk@vb@l}%
    \addtolength{\rk@mc@cur}{\rk@vb@r}%
    \divide\rk@mc@cur by 2\relax
    % Draw diagonal platform then horizontal with word
    \rk@extendbase
    \setlength{\rk@ta}{\rk@mc@cur}%
    \addtolength{\rk@ta}{\rk@modDepth}%
    \setlength{\rk@tb}{\rk@mc@y}%
    \addtolength{\rk@tb}{-\rk@modDepth}%
    \ifdim\rk@tb<\rk@clause@miny\global\rk@clause@miny=\rk@tb\fi
    \rk@line{(\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb)}%
    \setlength{\rk@halfsep}{\rk@spacing}%
    \divide\rk@halfsep by 2\relax
    % Measure word width, compute line_right, centre word on platform.
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font]
      (rk@iobjnode) at (0,0) {\phantom{#2}};%
    \pgfextractx{\rk@effmod}{\pgfpointanchor{rk@iobjnode}{east}}%
    \pgfextractx{\rk@tc}    {\pgfpointanchor{rk@iobjnode}{west}}%
    \addtolength{\rk@effmod}{-\rk@tc}%      rk@effmod = word_width
    \setlength{\rk@tc}{\rk@ta}%
    \addtolength{\rk@tc}{\rk@halfsep}%
    \addtolength{\rk@tc}{\rk@effmod}%
    \addtolength{\rk@tc}{\rk@halfsep}%      rk@tc = line_right
    \setlength{\rk@effmod}{\rk@ta}%
    \addtolength{\rk@effmod}{\rk@tc}%
    \divide\rk@effmod by 2\relax%           rk@effmod = centre_x
    \rk@line{(\the\rk@ta, \the\rk@tb) -- (\the\rk@tc, \the\rk@tb)}%
    \setlength{\rk@wlevel}{\rk@tb}\addtolength{\rk@wlevel}{\rk@wordlift}%
    \node[
      anchor    = base,
      inner sep = 0pt,
      outer sep = 0pt,
      font      = \rk@font,
    ] (rk@iobjnode) at (\the\rk@effmod, \the\rk@wlevel) {#2};%
    \global\rk@iobj@xmax=\rk@tc\relax
    % Mods on indirect object
    \ifblank{#1}{}{%
      \begingroup
        \setlength{\rk@mc@y}{\rk@tb}%
        \setlength{\rk@mc@cur}{\rk@ta}%
        \setlength{\rk@mc@d}{\rk@tc}%
        \rk@execmods{#1}%
      \endgroup
    }%
  \endgroup
  % Push main cursor past IObj platform to prevent DObj modifier collision.
  % Also extend the baseline so the line stays continuous.
  \ifdim\rk@iobj@xmax>\rk@x
    \rk@line{(\the\rk@x, \the\rk@vb@y) -- (\the\rk@iobj@xmax, \the\rk@vb@y)}%
    \setlength{\rk@x}{\rk@iobj@xmax}%
    % Re-centre verb word in the now-wider slot [vb@l … rk@x].
    % Erase the old (off-centre) text with a white rectangle, then place the word
    % at the correct new centre and redraw the baseline on top.
    \ifblank{\rk@vb@word}{}{%
      % White rectangle covering the old verb text (above the baseline).
      \setlength{\rk@tb}{\rk@vb@y}\addtolength{\rk@tb}{\rk@ht}\addtolength{\rk@tb}{4pt}%
      \fill[white] (\the\rk@vb@l, \the\rk@vb@y) rectangle (\the\rk@vb@r, \the\rk@tb);%
      % Place verb word at new centre.
      \setlength{\rk@ta}{\rk@vb@l}\addtolength{\rk@ta}{\rk@x}\divide\rk@ta by 2\relax
      \setlength{\rk@wlevel}{\rk@vb@y}\addtolength{\rk@wlevel}{\rk@wordlift}%
      \node[anchor=base, inner sep=0pt, outer sep=0pt, font=\rk@font]
        at (\the\rk@ta, \the\rk@wlevel) {\rk@vb@word};%
      % Redraw baseline (white fill covered it).
      \rk@line{(\the\rk@vb@l, \the\rk@vb@y) -- (\the\rk@x, \the\rk@vb@y)}%
    }%
  \fi
}

% ============================================================
% APPOSITIVE  (inline, parenthesized, on the current baseline)
% ============================================================

\newcommand{\rk@doappos}[1]{%
  \global\rk@subj@appostrue
  % Place in parens to the right of whatever the current drawn edge is
  \setlength{\rk@halfsep}{\rk@spacing}%
  \divide\rk@halfsep by 2\relax
  \setlength{\rk@ta}{\rk@mc@d}%
  \addtolength{\rk@ta}{\rk@halfsep}%
  % Inside appositive, disable modifier drawing (just typeset inline)
  \setlength{\rk@wlevel}{\rk@mc@y}\addtolength{\rk@wlevel}{\rk@wordlift}%
  \begingroup
    \let\rkAdj\rk@inline@mod
    \let\rkAdv\rk@inline@mod
    \let\rkPrep\rk@inline@prep
    \node[
      anchor    = base west,
      inner sep = 0pt,
      outer sep = 0pt,
      font      = \rk@font,
    ] (rk@apposnode) at (\the\rk@ta, \the\rk@wlevel) {(#1)};%
  \endgroup
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@apposnode}{east}}%
  \addtolength{\rk@ta}{\rk@halfsep}%
  % Extend baseline to appositive
  \rk@line{(\the\rk@mc@d, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@mc@y)}%
  \setlength{\rk@mc@d}{\rk@ta}%
  \setlength{\rk@mc@cur}{\rk@ta}%
}

% Inline stubs used inside appositive (suppress drawing)
\newcommand{\rk@inline@mod}[2][]{{#2}\space}
\newcommand{\rk@inline@prep}[3][]{#2~#3\space}

% ============================================================
% SUBORDINATE CLAUSE
% \rk@dosubclause{rel-word}{body}
% Called inside modifier list: draws a dashed vertical from head,
% then a sub-baseline below with the clause body.
% ============================================================

\newcommand{\rk@dosubclause}[2]{%
  \rk@extendbase
  % Attachment x = current cursor on head baseline
  % Attachment x = current modifier cursor + halfsep gap
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  \setlength{\rk@ta}{\rk@mc@cur}\addtolength{\rk@ta}{\rk@halfsep}%
  % Sub-baseline y = head_y - subClDepth
  \setlength{\rk@tb}{\rk@mc@y}%
  \addtolength{\rk@tb}{-\rk@subClDepth}%
  % Dashed vertical connector
  \draw[color=\rk@color, line width=\rk@lw, dashed]
    (\the\rk@ta, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb);%
  % Open a sub-context for the clause body.
  % Save the outer verb x: \rkVerb inside the sub-clause writes rk@vb@r globally,
  % which would overwrite the enclosing clause's verb position.
  \global\rk@sc@saved@vb@r=\rk@vb@r
  \begingroup
    % Reset x cursor and baseline y to the sub-clause level
    \setlength{\rk@x}{\rk@ta}%
    \setlength{\rk@ht}{2.2ex}%
    \setlength{\rk@base@y}{\rk@tb}%
    \setlength{\rk@mc@y}{\rk@tb}%
    \setlength{\rk@mc@d}{\rk@ta}%
    \setlength{\rk@mc@cur}{\rk@ta}%
    \rk@nounmodright=\rk@x  % reset so outer overhang doesn't bleed in
    % Place the rel-word (e.g. "who", "that", "because") first if provided
    \ifblank{#1}{}{%
      \rk@placeslot{#1}{\the\rk@base@y}%
      \rk@slot@to@mc
    }%
    % Execute clause body (\rkSubject, \rkVerb, etc.)
    #2%
    % Update parent cursor past the sub-clause extent
    \setlength{\rk@mc@cur}{\rk@x}%
    \ifdim\rk@x>\rk@mc@d \setlength{\rk@mc@d}{\rk@x}\fi
  \endgroup
  % Restore outer verb x (sub-clause \rkVerb wrote it globally)
  \global\rk@vb@r=\rk@sc@saved@vb@r
}

% ============================================================
% ENVIRONMENT
% ============================================================

% Internal state reset (called by both rkdiagram and rkCompoundSent)
% \rkSkip{len}      — insert a gap of <len> in the baseline before the next slot.
% \rkSlotWidth{len} — set minimum line width for the next slot.
% Both are one-shot: they reset automatically after the next slot is drawn.
\newcommand{\rkSkip}[1]{\setlength{\rk@slot@skip}{#1}}
\newcommand{\rkSlotWidth}[1]{\setlength{\rk@slot@minwidth}{#1}}
\newcommand{\rkSlantLen}[1]{\setlength{\rk@slant@minlen}{#1}}
\newcommand{\rkNomAbsHeight}[1]{\setlength{\rk@nomabs@height}{#1}}

\newcommand{\rk@init@state}{%
  \setlength{\rk@x}{0pt}%
  \setlength{\rk@ht}{2.2ex}%
  \setlength{\rk@mc@y}{0pt}%
  \setlength{\rk@mc@d}{0pt}%
  \setlength{\rk@mc@cur}{0pt}%
  % vb@* are reset and written globally so group boundaries don't restore stale values.
  \global\rk@vb@l=0pt
  \global\rk@vb@r=0pt
  \global\rk@vb@y=0pt
  \gdef\rk@vb@word{}%
  \gdef\rk@subj@word{}%
  \global\rk@subj@l=0pt
  \global\rk@subj@r=0pt
  \global\rk@subj@apposfalse
  \setlength{\rk@iobj@xmax}{0pt}%
  \setlength{\rk@nounmodright}{0pt}%
  \setlength{\rk@base@y}{0pt}%
  \setlength{\rk@slot@minwidth}{0pt}%
  \setlength{\rk@slot@skip}{0pt}%
  \setlength{\rk@slant@minlen}{0pt}%
  \setlength{\rk@nomabs@height}{0pt}%
  \setlength{\rk@clause@miny}{0pt}%
}

\NewDocumentEnvironment{rkdiagram}{O{}}{%
  \ifblank{#1}{}{\pgfkeys{/rkdiagram, #1}}%
  \ifrk@intikz
    % Nested inside \rkCompoundSent: preserve the clause baseline y set by the outer
    % command, reset everything else.
    \setlength{\rk@ta}{\rk@base@y}%   save
    \rk@init@state
    \setlength{\rk@base@y}{\rk@ta}%   restore
  \else
    \rk@init@state
    \begin{tikzpicture}[
      line width = \rk@lw,
      baseline   = (rk@origin),
    ]%
    \coordinate (rk@origin) at (0,0);
    % Measure descender depth so placed word nodes clear the baseline lines.
    \node[anchor=base,opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font]
      (rk@descmsr) at (0,0) {\phantom{g}};%
    \pgfextracty{\rk@wordlift}{\pgfpointanchor{rk@descmsr}{south}}%
    \setlength{\rk@wordlift}{-\rk@wordlift}%
    \addtolength{\rk@wordlift}{1pt}%
  \fi
}{%
  \ifrk@intikz\else
    \end{tikzpicture}%
  \fi
}

% ============================================================
% COMPOUND SENTENCE
% \rkCompoundSent[conj][sep]{opts1}{body1}{opts2}{body2}
%
% Draws two independent clauses in a single tikzpicture,
% connected by dashed verticals and a horizontal bridge bearing
% the coordinating conjunction.  The bridge sits at the midpoint
% between the two baselines, dropping from each clause's verb.
% ============================================================

% Registers for the connector
\newlength{\rk@cmpst@va@x}   % verb 1 midpoint x
\newlength{\rk@cmpst@vb@x}   % verb 2 midpoint x
\newlength{\rk@cmpst@sep}     % baseline separation

\NewDocumentCommand{\rkCompoundSent}{O{and} O{3cm} O{} m O{} m}{%
  % Reset manual bridge override before applying options (so default is auto)
  \setlength{\rk@bridgey@override}{0pt}%
  % Apply any options from either clause so spacing etc. are consistent
  \ifblank{#3}{}{\pgfkeys{/rkdiagram, #3}}%
  \ifblank{#5}{}{\pgfkeys{/rkdiagram, #5}}%
  \setlength{\rk@cmpst@sep}{#2}%
  \begin{tikzpicture}[line width=\rk@lw, baseline=(rk@origin)]%
    \coordinate (rk@origin) at (0,0);
    % Measure descender depth once for both clauses.
    \node[anchor=base,opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font]
      (rk@descmsr) at (0,0) {\phantom{g}};%
    \pgfextracty{\rk@wordlift}{\pgfpointanchor{rk@descmsr}{south}}%
    \setlength{\rk@wordlift}{-\rk@wordlift}\addtolength{\rk@wordlift}{1pt}%
    % ---- Clause 1 at y = 0 ----
    % rk@intikz suppresses the tikzpicture wrapper inside \begin{rkdiagram}.
    \rk@intikztrue
    \rk@init@state   % reset state; \begin{rkdiagram} in body will do this too (harmless)
    #4%
    % Save verb 1 x at right edge of verb slot (so dashed line drops from end of verb)
    \setlength{\rk@cmpst@va@x}{\rk@vb@r}%
    % Save clause 1 lowest y (for auto bridge placement)
    \setlength{\rk@cmpst@saved@miny}{\rk@clause@miny}%
    % ---- Clause 2 at y = -sep ----
    % Set base@y before #6 so the inner rkdiagram env (intikz branch) preserves it.
    \rk@init@state
    \setlength{\rk@base@y}{-\rk@cmpst@sep}%
    #6%
    % Save verb 2 x at right edge of verb slot
    \setlength{\rk@cmpst@vb@x}{\rk@vb@r}%
    % ---- Draw connector ----
    % rk@base@y is still -sep after clause 2; use it for clause-2 verb y.
    % bridge_y: default is -sep/2, but auto-lower if clause 1 modifiers extend past it.
    % bridgeY key overrides everything.
    \ifdim\rk@bridgey@override=0pt
      % Auto: start at -sep/2
      \setlength{\rk@ta}{\rk@base@y}%
      \divide\rk@ta by 2\relax%               rk@ta = -sep/2
      % Lower to miny_clause1 - 0.4cm if that is further down
      \setlength{\rk@tb}{\rk@cmpst@saved@miny}%
      \addtolength{\rk@tb}{-0.4cm}%           rk@tb = miny - gap
      \ifdim\rk@tb<\rk@ta\setlength{\rk@ta}{\rk@tb}\fi%  take the more-negative value
      % Clamp: keep bridge above clause 2 baseline by at least 0.3cm
      \setlength{\rk@tc}{\rk@base@y}\addtolength{\rk@tc}{0.3cm}%
      \ifdim\rk@ta<\rk@tc\setlength{\rk@ta}{\rk@tc}\fi
    \else
      \setlength{\rk@ta}{\rk@bridgey@override}%  rk@ta = bridge_y (manual)
    \fi%                                         rk@ta = bridge_y
    % bridge midpoint x = (va@x + vb@x) / 2
    \setlength{\rk@tc}{\rk@cmpst@va@x}%
    \addtolength{\rk@tc}{\rk@cmpst@vb@x}%
    \divide\rk@tc by 2\relax%                    rk@tc = bridge mid x
    % Dashed vertical from clause 1 verb down to bridge
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@cmpst@va@x, 0pt) -- (\the\rk@cmpst@va@x, \the\rk@ta);%
    % Dashed vertical from bridge down to clause 2 verb
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@cmpst@vb@x, \the\rk@ta) -- (\the\rk@cmpst@vb@x, \the\rk@base@y);%
    % Horizontal bridge
    \rk@line{(\the\rk@cmpst@va@x, \the\rk@ta) -- (\the\rk@cmpst@vb@x, \the\rk@ta)}%
    % Conjunction label above the bridge midpoint
    \node[above, inner sep=2pt, font=\rk@font]
      at (\the\rk@tc, \the\rk@ta) {\textit{#1}};%
    \rk@intikzfalse
  \end{tikzpicture}%
}

% ============================================================
% BASELINE COMMANDS
% ============================================================

\NewDocumentCommand{\rkSubject}{O{}m}{%
  \def\rk@cmpdir{r}%
  \gdef\rk@subj@word{#2}%
  \rk@placeslot{#2}{\the\rk@base@y}%
  % If the subject word sits on an elevated platform (gerund/infinitive), the
  % \rk@divfull re-centering would render its \rkGerund/\rkInfinitive fallback
  % as plain text at the baseline.  Suppress it by clearing \rk@subj@word.
  \ifdim\rk@sl@y>\rk@base@y\gdef\rk@subj@word{}\fi
  \global\rk@subj@l=\rk@sl@l
  \global\rk@subj@r=\rk@sl@r
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkVerb}{O{}m}{%
  \rk@divfull
  \def\rk@cmpdir{l}%
  \gdef\rk@vb@word{#2}%
  \rk@placeslot{#2}{\the\rk@base@y}%
  % Save verb slot globally so \rkCompoundSent can read vb@r after \end{rkdiagram}
  % closes the environment's implicit group.
  \global\rk@vb@l=\rk@sl@l
  \global\rk@vb@r=\rk@sl@r
  \global\rk@vb@y=\rk@sl@y
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkDObj}{O{}m}{%
  \rk@divshort
  \def\rk@cmpdir{l}%
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkPredNom}{O{}m}{%
  \rk@divfwd
  \def\rk@cmpdir{l}%
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkPredAdj}{O{}m}{%
  \rk@divfwd
  \def\rk@cmpdir{l}%
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkIObj}{O{}m}{%
  % Indirect object: platform below verb, does not advance main cursor
  \rk@doiobj{#1}{#2}%
}

