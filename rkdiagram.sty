% ============================================================
% COMPOUND STRUCTURE
% \rkCompound[conjunction]{word1}{word2}
% Inside \rkSubject/\rkVerb/\rkDObj etc., intercepted by \rk@deferred@Compound
% and rendered as a proper forked compound via \rk@docompound.
% Outside a diagram context the inline fallback applies.
% ============================================================

% \rk@docompound{dir}{conj}{worda}{wordb}
%   dir = r  subject  (convergence RIGHT, dashed bar on LEFT)
%   dir = l  verb/obj (convergence LEFT,  dashed bar on RIGHT)
\newcommand{\rk@docompound}[4]{%
  % rk@ta = csep  (vertical half-gap between platforms; also horizontal slant size)
  \setlength{\rk@ta}{\rk@ht}%
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  % Measure word widths in inline-mod context (inline \rkAdj etc.)
  \begingroup
    \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@cmpA)at(0,0){#3};%
    \node[opacity=0,inner sep=0pt,outer sep=0pt,font=\rk@font](rk@cmpB)at(0,0){#4};%
  \endgroup
  \pgfextractx{\rk@effmod}{\pgfpointanchor{rk@cmpA}{east}}%
  \pgfextractx{\rk@tb}    {\pgfpointanchor{rk@cmpA}{west}}%
  \addtolength{\rk@effmod}{-\rk@tb}%           rk@effmod = width_A
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@cmpB}{east}}%
  \pgfextractx{\rk@tb}{\pgfpointanchor{rk@cmpB}{west}}%
  \addtolength{\rk@tc}{-\rk@tb}%               rk@tc = width_B
  \ifdim\rk@tc>\rk@effmod\setlength{\rk@effmod}{\rk@tc}\fi
  % rk@effmod = max word width; platform width = max + full spacing margin
  \addtolength{\rk@effmod}{\rk@spacing}%
  %
  \if r#1%  %----- SUBJECT: convergence RIGHT --------------------------
    % plat_l = rk@x,  bar_x = rk@x + effmod + gap,  conv_x = bar_x + csep
    % gap = rk@halfsep separates the text platform end from the dashed bar
    \setlength{\rk@tb}{\rk@x}\addtolength{\rk@tb}{\rk@effmod}%  rk@tb = text end x
    \addtolength{\rk@tb}{\rk@halfsep}%                           rk@tb = bar_x (+ gap)
    \setlength{\rk@tc}{\rk@tb}\addtolength{\rk@tc}{\rk@ta}%     rk@tc = conv_x
    % text_x = plat_l + halfsep  (reuse rk@sl@l as scratch)
    \setlength{\rk@sl@l}{\rk@x}\addtolength{\rk@sl@l}{\rk@halfsep}%
    % Place word nodes (inline-mod context prevents \rkAdj etc. from calling \draw)
    \begingroup
      \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
      \node[anchor=base west,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpAN)at(\the\rk@sl@l, \the\rk@ta){#3};%
      \node[anchor=base west,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpBN)at(\the\rk@sl@l,-\the\rk@ta){#4};%
    \endgroup
    % Platform baselines
    \rk@line{(\the\rk@x, \the\rk@ta)--(\the\rk@tb, \the\rk@ta)}%
    \rk@line{(\the\rk@x,-\the\rk@ta)--(\the\rk@tb,-\the\rk@ta)}%
    % Dashed vertical + conjunction label at the platform/slant junction (plat_r)
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@tb, \the\rk@ta)--(\the\rk@tb,-\the\rk@ta)
      node[midway,inner sep=2pt,font=\rk@font,rotate=90]{\textit{#2}};%
    % Convergence slants on the right (connecting) end
    \rk@line{(\the\rk@tb, \the\rk@ta)--(\the\rk@tc,0pt)}%
    \rk@line{(\the\rk@tb,-\the\rk@ta)--(\the\rk@tc,0pt)}%
    % Update rk@ht so the subsequent divider is tall enough
    \pgfextracty{\rk@tb}{\pgfpointanchor{rk@cmpAN}{north}}%
    \ifdim\rk@tb>\rk@ht\setlength{\rk@ht}{\rk@tb}\fi
    % Slot registers
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%
    \setlength{\rk@sl@y}{0pt}\setlength{\rk@x}{\rk@tc}%
  \else%   %----- VERB / OBJ: convergence LEFT --------------------------
    % conv_x = rk@x,  junc_x = rk@x + csep,  bar_x = junc_x + gap,  plat_r = bar_x + effmod
    % gap = rk@halfsep separates the dashed bar from the slant endpoints
    \setlength{\rk@tb}{\rk@x}\addtolength{\rk@tb}{\rk@ta}%      rk@tb = junc_x (slant end)
    \setlength{\rk@sl@l}{\rk@tb}\addtolength{\rk@sl@l}{\rk@halfsep}% rk@sl@l = bar_x (temp)
    \setlength{\rk@tc}{\rk@sl@l}\addtolength{\rk@tc}{\rk@effmod}%   rk@tc = plat_r
    % text_x = bar_x + halfsep  (reuse rk@effmod as scratch — no longer needed for widths)
    \setlength{\rk@effmod}{\rk@sl@l}\addtolength{\rk@effmod}{\rk@halfsep}%
    % Place word nodes (inline-mod context)
    \begingroup
      \let\rkAdj\rk@inline@mod\let\rkAdv\rk@inline@mod\let\rkPrep\rk@inline@prep
      \node[anchor=base west,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpAN)at(\the\rk@effmod, \the\rk@ta){#3};%
      \node[anchor=base west,inner sep=0pt,outer sep=0pt,font=\rk@font]
        (rk@cmpBN)at(\the\rk@effmod,-\the\rk@ta){#4};%
    \endgroup
    % Platform baselines: from junc_x all the way to plat_r (covers the gap visually)
    \rk@line{(\the\rk@tb, \the\rk@ta)--(\the\rk@tc, \the\rk@ta)}%
    \rk@line{(\the\rk@tb,-\the\rk@ta)--(\the\rk@tc,-\the\rk@ta)}%
    % Convergence slants on the left (connecting) end
    \rk@line{(\the\rk@x,0pt)--(\the\rk@tb, \the\rk@ta)}%
    \rk@line{(\the\rk@x,0pt)--(\the\rk@tb,-\the\rk@ta)}%
    % Dashed vertical + conjunction label at bar_x (pushed away from slant junction)
    \draw[color=\rk@color,line width=\rk@lw,dashed]
      (\the\rk@sl@l, \the\rk@ta)--(\the\rk@sl@l,-\the\rk@ta)
      node[midway,inner sep=2pt,font=\rk@font,rotate=90]{\textit{#2}};%
    % Slot registers
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@tc}\setlength{\rk@sl@d}{\rk@tc}%
    \setlength{\rk@sl@y}{0pt}\setlength{\rk@x}{\rk@tc}%
  \fi
}

% Inline fallback (used outside diagram context or as a safety net)
\NewDocumentCommand{\rkCompound}{O{and}mm}{%
  \begingroup
    \let\rkAdj\rk@inline@mod
    \let\rkAdv\rk@inline@mod
    \let\rkPrep\rk@inline@prep
    #3~\textit{#1}~#2%
  \endgroup
}

