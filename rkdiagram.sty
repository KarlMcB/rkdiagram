%%
%% rkdiagram.sty  —  Reed-Kellogg sentence diagrams for LaTeX
%% Version 1.1  |  Requires LuaLaTeX or pdfLaTeX + TikZ
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rkdiagram}[2026/06/02 v1.1 Reed-Kellogg sentence diagrams]

\RequirePackage{tikz}
\usetikzlibrary{calc,positioning}
\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{pgfopts}

% Execute a modifier/submod token list, stripping catcode-12 commas first.
\ExplSyntaxOn
\newcommand{\rk@execmods}[1]{%
  \tl_set:Nn \l_tmpa_tl {#1}%
  \tl_remove_all:Nn \l_tmpa_tl {,}%
  \tl_use:N \l_tmpa_tl
}
\ExplSyntaxOff

% ============================================================
% CONFIGURATION LENGTHS AND FLAGS
% ============================================================

\newlength{\rk@spacing}    \setlength{\rk@spacing}{1.2cm}
\newlength{\rk@modDepth}   \setlength{\rk@modDepth}{1.0cm}
\newlength{\rk@subClDepth} \setlength{\rk@subClDepth}{2.5cm}
\newlength{\rk@lw}         \setlength{\rk@lw}{0.4pt}
% gerundPost: post height for the gerund pedestal (0pt = use modDepth)
\newlength{\rk@gerundPost} \setlength{\rk@gerundPost}{0pt}
\newcommand{\rk@color}{black}
\newcommand{\rk@font}{}
\newif\ifrk@showroles \rk@showrolesfalse

\pgfkeys{
  /rkdiagram/.is family, /rkdiagram,
  font/.code           = {\renewcommand{\rk@font}{#1}},
  spacing/.code        = {\setlength{\rk@spacing}{#1}},
  modDepth/.code       = {\setlength{\rk@modDepth}{#1}},
  subClauseDepth/.code = {\setlength{\rk@subClDepth}{#1}},
  gerundPost/.code     = {\setlength{\rk@gerundPost}{#1}},
  linewidth/.code      = {\setlength{\rk@lw}{#1}},
  color/.code          = {\renewcommand{\rk@color}{#1}},
  showroles/.is if     = rk@showroles,
}

\ProcessPgfOptions{/rkdiagram}

% \rkset{key=val,...} — override defaults mid-document
\newcommand{\rkset}[1]{\pgfkeys{/rkdiagram, #1}}

% ============================================================
% INTERNAL STATE
% ============================================================

\newlength{\rk@x}       % main baseline x cursor
\newlength{\rk@ht}      % running max word height (used for divider length)
\newlength{\rk@base@y}  % current baseline y (0pt on main; overridden in sub-contexts)
\newlength{\rk@effmod}  % scratch: effective post/mod depth in current operation

% Current slot — set by \rk@placeslot
\newlength{\rk@sl@l}   % left x
\newlength{\rk@sl@r}   % right x
\newlength{\rk@sl@d}   % drawn right x (for baseline extension)
\newlength{\rk@sl@y}   % y level

% Verb slot — saved separately so \rkIObj can attach to it
\newlength{\rk@vb@l}
\newlength{\rk@vb@r}
\newlength{\rk@vb@y}

% Modifier context — saved/restored via \begingroup
\newlength{\rk@mc@y}    % head y level
\newlength{\rk@mc@d}    % head drawn-right x
\newlength{\rk@mc@cur}  % attachment cursor x

% Scratch length registers (\newlength = \newdimen, safe for \pgfextractx)
\newlength{\rk@ta}
\newlength{\rk@tb}
\newlength{\rk@tc}
\newlength{\rk@halfsep}

% Gerund pedestal state (global; written inside groups, read outside)
\newlength{\rk@ger@topright}  % right edge of gerund top structure
\newlength{\rk@ger@footleft}  % left edge of gerund foot (= rk@x on entry)

% Deferred subclause — used when \rkSubClause appears as a word argument.
\newif\ifrk@deferredsc  \rk@deferredscfalse
\newcommand{\rk@deferredsc@rw}{}
\newcommand{\rk@deferredsc@body}{}
\newcommand{\rk@deferred@SubClause}[2][]{%
  \global\rk@deferredsctrue
  \gdef\rk@deferredsc@rw{#1}%
  \gdef\rk@deferredsc@body{#2}%
}

% Deferred gerund — used when \rkGerund appears as a word argument.
\newif\ifrk@deferredger  \rk@deferredgerfalse
\newcommand{\rk@deferredger@body}{}
\newcommand{\rk@deferredger@word}{}
\NewDocumentCommand{\rk@deferred@Gerund}{O{} m}{%
  \global\rk@deferredgertrue
  \gdef\rk@deferredger@body{#1}%
  \gdef\rk@deferredger@word{#2}%
}

% ============================================================
% DRAW SHORTHAND
% ============================================================

\newcommand{\rk@line}[1]{%
  \draw[color=\rk@color, line width=\rk@lw] #1;%
}

% ============================================================
% PLACE A WORD ON A BASELINE SLOT
% \rk@placeslot{word}{y}
% Draws the word node + baseline segment; records slot; advances \rk@x.
% ============================================================

\newcommand{\rk@placeslot}[2]{%
  \global\rk@deferredscfalse
  \global\rk@deferredgerfalse
  \setlength{\rk@halfsep}{\rk@spacing}%
  \divide\rk@halfsep by 2\relax
  \setlength{\rk@ta}{\rk@x}%
  \addtolength{\rk@ta}{\rk@halfsep}%
  % Detect structural elements used as word arguments.
  \begingroup
    \let\rkSubClause\rk@deferred@SubClause
    \let\rkGerund\rk@deferred@Gerund
    \node[
      anchor    = base west,
      inner sep = 0pt,
      outer sep = 0pt,
      font      = \rk@font,
    ] (rk@wnode) at (\the\rk@ta, #2) {#1};%
  \endgroup
  \ifrk@deferredger
    % Gerund: draw the full T-shaped pedestal.
    \rk@dogerund{\rk@deferredger@body}{\rk@deferredger@word}%
    \global\rk@deferredgerfalse
  \else
    % Normal word (or deferred subclause): measure, draw baseline, record slot.
    \pgfextractx{\rk@tb}{\pgfpointanchor{rk@wnode}{east}}%
    \addtolength{\rk@tb}{\rk@halfsep}%
    \pgfextracty{\rk@tc}{\pgfpointanchor{rk@wnode}{north}}%
    \ifdim\rk@tc>\rk@ht \setlength{\rk@ht}{\rk@tc}\fi
    \rk@line{(\the\rk@x, #2) -- (\the\rk@tb, #2)}%
    \setlength{\rk@sl@l}{\rk@x}%
    \setlength{\rk@sl@r}{\rk@tb}%
    \setlength{\rk@sl@d}{\rk@tb}%
    \setlength{\rk@sl@y}{#2}%
    \setlength{\rk@x}{\rk@tb}%
    \ifrk@deferredsc
      \rk@slot@to@mc
      \rk@dosubclause{\rk@deferredsc@rw}{\rk@deferredsc@body}%
      \global\rk@deferredscfalse
    \fi
  \fi
}

% Set modifier context from current slot (cursor starts at slot left)
\newcommand{\rk@slot@to@mc}{%
  \setlength{\rk@mc@y}{\rk@sl@y}%
  \setlength{\rk@mc@d}{\rk@sl@d}%
  \setlength{\rk@mc@cur}{\rk@sl@l}%
}

% ============================================================
% SHOW ROLE LABEL  (showroles option)
% ============================================================

\newcommand{\rk@showrole}[1]{%
  \ifrk@showroles
    \node[
      above     = 1pt,
      font      = \tiny\color{gray},
      inner sep = 0pt,
    ] at (rk@wnode.north) {#1};%
  \fi
}

% ============================================================
% DIVIDERS
% All use \rk@base@y so they work on any baseline level.
% ============================================================

% Full vertical bar  (subject | verb)
\newcommand{\rk@divfull}{%
  \setlength{\rk@ta}{\rk@ht}%
  \addtolength{\rk@ta}{0.18cm}%
  \setlength{\rk@tb}{\rk@base@y}\addtolength{\rk@tb}{-0.18cm}%  bottom
  \setlength{\rk@tc}{\rk@base@y}\addtolength{\rk@tc}{\rk@ta}%   top
  \rk@line{(\the\rk@x, \the\rk@tb) -- (\the\rk@x, \the\rk@tc)}%
}

% Short vertical bar  (verb | direct object)
\newcommand{\rk@divshort}{%
  \setlength{\rk@ta}{\rk@ht}%
  \addtolength{\rk@ta}{0.10cm}%
  \setlength{\rk@tc}{\rk@base@y}\addtolength{\rk@tc}{\rk@ta}%
  \rk@line{(\the\rk@x, \the\rk@base@y) -- (\the\rk@x, \the\rk@tc)}%
}

% Forward diagonal  (verb / predNom or predAdj)
\newcommand{\rk@divfwd}{%
  \setlength{\rk@ta}{\rk@ht}%
  \addtolength{\rk@ta}{0.18cm}%
  \pgfmathsetlength{\rk@tb}{\the\rk@ta / tan(60)}%
  \setlength{\rk@tc}{\rk@base@y}\addtolength{\rk@tc}{-0.10cm}%
  \rk@line{(\the\rk@x, \the\rk@tc) -- ++(\the\rk@tb, \the\rk@ta)}%
}

% ============================================================
% MODIFIER DRAWING
% ============================================================

\newcommand{\rk@extendbase}{%
  \ifdim\rk@mc@cur>\rk@mc@d
    \rk@line{(\the\rk@mc@d, \the\rk@mc@y) -- (\the\rk@mc@cur, \the\rk@mc@y)}%
    \setlength{\rk@mc@d}{\rk@mc@cur}%
  \fi
}

\newcommand{\rk@domod}[2]{%
  \rk@extendbase
  \setlength{\rk@ta}{\rk@mc@cur}\addtolength{\rk@ta}{\rk@modDepth}%
  \setlength{\rk@tb}{\rk@mc@y} \addtolength{\rk@tb}{-\rk@modDepth}%
  \draw[color=\rk@color, line width=\rk@lw]
    (\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb)
    node[midway, above, sloped,
         inner sep=2pt, outer sep=0pt, font=\rk@font] {#1};%
  \addtolength{\rk@mc@cur}{\rk@modDepth}%
  \ifdim\rk@mc@cur>\rk@mc@d \setlength{\rk@mc@d}{\rk@mc@cur}\fi
  \ifblank{#2}{}{%
    \begingroup
      \setlength{\rk@mc@y}{\rk@tb}%
      \setlength{\rk@mc@d}{\rk@ta}%
      \setlength{\rk@mc@cur}{\rk@ta}%
      \rk@execmods{#2}%
    \endgroup
  }%
}

\newcommand{\rk@runmods}[1]{%
  \ifblank{#1}{}{%
    \begingroup
      \rk@execmods{#1}%
    \endgroup
  }%
}

% ============================================================
% PREP PHRASE DRAWING
% ============================================================

\newcommand{\rk@doprep}[3]{%
  \rk@extendbase
  \setlength{\rk@ta}{\rk@mc@cur}\addtolength{\rk@ta}{\rk@modDepth}%
  \setlength{\rk@tb}{\rk@mc@y} \addtolength{\rk@tb}{-\rk@modDepth}%
  \node[
    rotate    = -45,
    anchor    = base west,
    inner sep = 0pt,
    outer sep = 0pt,
    font      = \rk@font,
  ] (rk@prepnode) at (\the\rk@ta, \the\rk@tb) {#2};%
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@prepnode}{east}}%
  \pgfextracty{\rk@tb}{\pgfpointanchor{rk@prepnode}{east}}%
  \rk@line{(\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb)}%
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  \setlength{\rk@tc}{\rk@ta}\addtolength{\rk@tc}{\rk@halfsep}%
  \node[
    anchor    = base west,
    inner sep = 0pt,
    outer sep = 0pt,
    font      = \rk@font,
  ] (rk@pobjnode) at (\the\rk@tc, \the\rk@tb) {#3};%
  \pgfextractx{\rk@tc}{\pgfpointanchor{rk@pobjnode}{east}}%
  \addtolength{\rk@tc}{\rk@halfsep}%
  \rk@line{(\the\rk@ta, \the\rk@tb) -- (\the\rk@tc, \the\rk@tb)}%
  \setlength{\rk@mc@cur}{\rk@tc}%
  \ifdim\rk@tc>\rk@mc@d \setlength{\rk@mc@d}{\rk@tc}\fi
  \ifblank{#1}{}{%
    \begingroup
      \setlength{\rk@mc@y}{\rk@tb}%
      \pgfextractx{\rk@ta}{\pgfpointanchor{rk@pobjnode}{west}}%
      \setlength{\rk@mc@cur}{\rk@ta}\addtolength{\rk@mc@cur}{-\rk@halfsep}%
      \pgfextractx{\rk@ta}{\pgfpointanchor{rk@pobjnode}{east}}%
      \setlength{\rk@mc@d}{\rk@ta}  \addtolength{\rk@mc@d}{\rk@halfsep}%
      \rk@execmods{#1}%
    \endgroup
  }%
}

% ============================================================
% INDIRECT OBJECT PLATFORM
% ============================================================

\newcommand{\rk@doiobj}[2]{%
  \begingroup
    \setlength{\rk@mc@y}{\rk@vb@y}%
    \setlength{\rk@mc@d}{\rk@vb@r}%
    \setlength{\rk@mc@cur}{\rk@vb@l}\addtolength{\rk@mc@cur}{\rk@vb@r}%
    \divide\rk@mc@cur by 2\relax
    \rk@extendbase
    \setlength{\rk@ta}{\rk@mc@cur}\addtolength{\rk@ta}{\rk@modDepth}%
    \setlength{\rk@tb}{\rk@mc@y}  \addtolength{\rk@tb}{-\rk@modDepth}%
    \rk@line{(\the\rk@mc@cur, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb)}%
    \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
    \setlength{\rk@tc}{\rk@ta}\addtolength{\rk@tc}{\rk@halfsep}%
    \node[
      anchor    = base west,
      inner sep = 0pt,
      outer sep = 0pt,
      font      = \rk@font,
    ] (rk@iobjnode) at (\the\rk@tc, \the\rk@tb) {#2};%
    \pgfextractx{\rk@tc}{\pgfpointanchor{rk@iobjnode}{east}}%
    \addtolength{\rk@tc}{\rk@halfsep}%
    \rk@line{(\the\rk@ta, \the\rk@tb) -- (\the\rk@tc, \the\rk@tb)}%
    \ifblank{#1}{}{%
      \begingroup
        \setlength{\rk@mc@y}{\rk@tb}%
        \setlength{\rk@mc@cur}{\rk@ta}%
        \setlength{\rk@mc@d}{\rk@tc}%
        \rk@execmods{#1}%
      \endgroup
    }%
  \endgroup
}

% ============================================================
% GERUND PEDESTAL
% \rk@dogerund{body}{word}
%
% Draws a T-shaped pedestal at the current baseline:
%
%        word  [body extends right: DObj, etc.]
%   ____________________________________________   ← top line (top_y = base_y + post)
%           |
%   ________________________   ← foot line  (at base_y, same x span as top)
%
% The post is centred horizontally under the top structure.
%
% After this routine, slot registers reflect the gerund WORD's position on
% the top line, so outer modifier lists from \rkSubject[mods]{} etc. attach
% from the top line rather than the foot.
% ============================================================

\newcommand{\rk@dogerund}[2]{%
  % Post height: gerundPost if non-zero, else modDepth.
  \ifdim\rk@gerundPost>0pt
    \setlength{\rk@effmod}{\rk@gerundPost}%
  \else
    \setlength{\rk@effmod}{\rk@modDepth}%
  \fi
  % top_y = base_y + post_height  (stored in rk@tc for later use)
  \setlength{\rk@tc}{\rk@base@y}\addtolength{\rk@tc}{\rk@effmod}%
  % Save foot_left globally before entering the group.
  \global\rk@ger@footleft=\rk@x
  % ---- Mini-baseline group at top_y --------------------------------
  \begingroup
    \setlength{\rk@base@y}{\rk@tc}%   top_y is now the working baseline
    \setlength{\rk@ht}{2.2ex}%
    \setlength{\rk@vb@l}{0pt}\setlength{\rk@vb@r}{0pt}\setlength{\rk@vb@y}{0pt}%
    % Place the gerund word on the top line.
    \rk@placeslot{#2}{\the\rk@base@y}%
    % Export gerund word's slot registers globally, BEFORE body commands
    % overwrite them.  These are what \rk@slot@to@mc will use when the outer
    % baseline command (e.g. \rkSubject) calls it after \rk@placeslot returns.
    \global\rk@sl@l=\rk@sl@l
    \global\rk@sl@r=\rk@sl@r
    \global\rk@sl@d=\rk@sl@d
    \global\rk@sl@y=\rk@sl@y    % = top_y
    \rk@slot@to@mc
    % Run body commands (DObj, Adv, Prep, etc.) on the top line.
    \ifblank{#1}{}{\rk@execmods{#1}}%
    % Export right edge of the full top structure.
    \global\rk@ger@topright=\rk@x
  \endgroup
  % ---- Draw pedestal lines -----------------------------------------
  % Post: centred horizontally, from foot (base_y) up to top_y (rk@tc).
  \setlength{\rk@ta}{\rk@ger@footleft}\addtolength{\rk@ta}{\rk@ger@topright}%
  \divide\rk@ta by 2\relax%   rk@ta = post_x
  \rk@line{(\the\rk@ta, \the\rk@base@y) -- (\the\rk@ta, \the\rk@tc)}%
  % Foot: horizontal line at base_y spanning the full structure width.
  \rk@line{(\the\rk@ger@footleft, \the\rk@base@y) -- (\the\rk@ger@topright, \the\rk@base@y)}%
  % ---- Update outer state ------------------------------------------
  % Advance main cursor to right edge of the structure.
  \setlength{\rk@x}{\rk@ger@topright}%
  % Increase rk@ht by post_height so dividers (drawn after us) are tall enough.
  \addtolength{\rk@ht}{\rk@effmod}%
  % Slot registers were globally exported above; rk@sl@y = top_y so outer
  % modifier lists attach from the top line.  No further action needed here.
}

% ============================================================
% APPOSITIVE  (inline, parenthesized, on the current baseline)
% ============================================================

\newcommand{\rk@doappos}[1]{%
  \setlength{\rk@halfsep}{\rk@spacing}\divide\rk@halfsep by 2\relax
  \setlength{\rk@ta}{\rk@mc@d}\addtolength{\rk@ta}{\rk@halfsep}%
  \begingroup
    \let\rkAdj\rk@inline@mod
    \let\rkAdv\rk@inline@mod
    \let\rkPrep\rk@inline@prep
    \node[
      anchor    = base west,
      inner sep = 0pt,
      outer sep = 0pt,
      font      = \rk@font,
    ] (rk@apposnode) at (\the\rk@ta, \the\rk@mc@y) {(#1)};%
  \endgroup
  \pgfextractx{\rk@ta}{\pgfpointanchor{rk@apposnode}{east}}%
  \addtolength{\rk@ta}{\rk@halfsep}%
  \rk@line{(\the\rk@mc@d, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@mc@y)}%
  \setlength{\rk@mc@d}{\rk@ta}%
  \setlength{\rk@mc@cur}{\rk@ta}%
}

\newcommand{\rk@inline@mod}[2][]{{#2}\space}
\newcommand{\rk@inline@prep}[3][]{#2~#3\space}

% ============================================================
% SUBORDINATE CLAUSE
% \rk@dosubclause{rel-word}{body}
% ============================================================

\newcommand{\rk@dosubclause}[2]{%
  \rk@extendbase
  \setlength{\rk@ta}{\rk@mc@cur}%
  \setlength{\rk@tb}{\rk@mc@y}\addtolength{\rk@tb}{-\rk@subClDepth}%
  \draw[color=\rk@color, line width=\rk@lw, dashed]
    (\the\rk@ta, \the\rk@mc@y) -- (\the\rk@ta, \the\rk@tb);%
  \begingroup
    \setlength{\rk@x}{\rk@ta}%
    \setlength{\rk@ht}{2.2ex}%
    \setlength{\rk@base@y}{\rk@tb}%   ← sub-clause baseline level
    \setlength{\rk@mc@y}{\rk@tb}%
    \setlength{\rk@mc@d}{\rk@ta}%
    \setlength{\rk@mc@cur}{\rk@ta}%
    \setlength{\rk@vb@l}{0pt}\setlength{\rk@vb@r}{0pt}\setlength{\rk@vb@y}{0pt}%
    \ifblank{#1}{}{%
      \rk@placeslot{#1}{\the\rk@base@y}%
      \rk@slot@to@mc
    }%
    #2%
    \setlength{\rk@mc@cur}{\rk@x}%
    \ifdim\rk@x>\rk@mc@d \setlength{\rk@mc@d}{\rk@x}\fi
  \endgroup
}

% ============================================================
% ENVIRONMENT
% ============================================================

\NewDocumentEnvironment{rkdiagram}{O{}}{%
  \ifblank{#1}{}{\pgfkeys{/rkdiagram, #1}}%
  \setlength{\rk@x}{0pt}%
  \setlength{\rk@ht}{2.2ex}%
  \setlength{\rk@base@y}{0pt}%
  \setlength{\rk@mc@y}{0pt}%
  \setlength{\rk@mc@d}{0pt}%
  \setlength{\rk@mc@cur}{0pt}%
  \setlength{\rk@vb@l}{0pt}%
  \setlength{\rk@vb@r}{0pt}%
  \setlength{\rk@vb@y}{0pt}%
  \begin{tikzpicture}[
    line width = \rk@lw,
    baseline   = (rk@origin),
  ]%
  \coordinate (rk@origin) at (0,0);
}{%
  \end{tikzpicture}%
}

% ============================================================
% BASELINE COMMANDS
% All use \the\rk@base@y so they work on any baseline level
% (main, sub-clause, gerund top line, etc.).
% ============================================================

\NewDocumentCommand{\rkSubject}{O{}m}{%
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@showrole{subj}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkVerb}{O{}m}{%
  \rk@divfull
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@showrole{vb}%
  \setlength{\rk@vb@l}{\rk@sl@l}%
  \setlength{\rk@vb@r}{\rk@sl@r}%
  \setlength{\rk@vb@y}{\rk@sl@y}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkDObj}{O{}m}{%
  \rk@divshort
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@showrole{dobj}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkPredNom}{O{}m}{%
  \rk@divfwd
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@showrole{pnom}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkPredAdj}{O{}m}{%
  \rk@divfwd
  \rk@placeslot{#2}{\the\rk@base@y}%
  \rk@showrole{padj}%
  \rk@slot@to@mc
  \rk@runmods{#1}%
}

\NewDocumentCommand{\rkIObj}{O{}m}{%
  \rk@doiobj{#1}{#2}%
}

% ============================================================
% MODIFIER COMMANDS
% ============================================================

\NewDocumentCommand{\rkAdj}{O{}m}{\rk@domod{#2}{#1}}
\NewDocumentCommand{\rkAdv}{O{}m}{\rk@domod{#2}{#1}}

% ============================================================
% PREPOSITIONAL PHRASE
% ============================================================

\NewDocumentCommand{\rkPrep}{O{}mm}{\rk@doprep{#1}{#2}{#3}}

% ============================================================
% COMPOUND STRUCTURE (simplified inline fallback)
% ============================================================

\NewDocumentCommand{\rkCompound}{O{and}mm}{%
  \begingroup
    \let\rkAdj\rk@inline@mod
    \let\rkAdv\rk@inline@mod
    \let\rkPrep\rk@inline@prep
    #3~\textit{#1}~#2%
  \endgroup
}

% ============================================================
% APPOSITIVE
% ============================================================

\NewDocumentCommand{\rkAppos}{m}{\rk@doappos{#1}}

% ============================================================
% SUBORDINATE CLAUSE
% ============================================================

\NewDocumentCommand{\rkSubClause}{O{}m}{\rk@dosubclause{#1}{#2}}

% ============================================================
% GERUND
% \rkGerund[body]{word}
%
% Renders a Reed-Kellogg gerund pedestal.  Use as the word argument
% of any baseline command:
%
%   \rkSubject{\rkGerund[body]{word}}
%   \rkDObj{\rkGerund[body]{word}}
%   \rkPredNom{\rkGerund[body]{word}}   (rare but valid)
%
% The optional [body] is a comma-separated list of commands run on the
% gerund's own top line after the word is placed.  Supported:
%
%   \rkDObj[\mods]{obj}          — direct object of the gerund
%   \rkAdv{adv}                  — adverb modifying the gerund
%   \rkPrep[\mods]{prep}{obj}    — prepositional phrase
%
% The enclosing command's own optional modifier list (if any) attaches
% from the gerund word's position on the top line.
%
% The pedestal post height is controlled globally by \rkset{gerundPost=len}
% or per-diagram via the environment option; default is modDepth (1.0 cm).
%
% Outside a diagram word-arg context the command is a no-op fallback
% that typsets the word in plain text.
% ============================================================

\NewDocumentCommand{\rkGerund}{O{} m}{#2}

\endinput
